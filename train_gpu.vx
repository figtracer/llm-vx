// GPT-2 training on the GPU. Every buffer a training step touches is a tensor
// placed in `Memory::GPU_HBM`, allocated in `run` so Vx's capacity check sees the
// whole step at once. Compile against a machine file that gives GPU_HBM a GPU's
// capacity, and the compiler answers whether this exact program fits that GPU.
//
// Mode 0 checks one forward and backward pass and ten AdamW steps against a
// reference, as test_gpt2.vx does. Mode 1 trains, as train.vx does. Mode 2 runs
// five training steps only, for memory and speed measurements.
//
// Shapes must be compile-time constants that Vx can match by name, so each
// extent is its own generic parameter: C3 = 3C, C4 = 4C, BT = B*T,
// LBT = L*B*T, RA = L*B*NH*T, LC = L*C, LC3 = L*3C, LC4 = L*4C.
import data;
import gpu;
import utils;
import std::time;

extern "C" {
  fn fabsf(x : f32) -> f32;
}

// The time now. In mode 2 it waits for the GPU first, so the times between
// calls split a step into phases; in the other modes it does not wait.
fn phase_time(mode : i32) -> f64 {
  if mode == 2 { unsafe { vx_synchronize(); } }
  return unix_timestamp();
}

// Fills `t` from `src` starting at element `off`, and answers the next offset.
fn load<const R : i32, const C : i32>(t : &mut Tensor<f32, [R, C]>, src : *mut f32, off : i64) -> i64 {
  for r in 0..R {
    for c in 0..C {
      unsafe { t[r][c] = src[off + (r as i64) * (C as i64) + (c as i64)]; }
    }
  }
  return off + (R as i64) * (C as i64);
}

// Compares n values of a from a_off with b from b_off. Answers whether every
// difference is within `tol` of b's largest magnitude, and prints the largest
// difference.
fn check_close(a : *mut f32, a_off : i64, b : *mut f32, b_off : i64, n : i64, tol : f32,
               label : *const i8) -> bool {
  let mut maxdiff : f32 = 0.0;
  let mut maxabs : f32 = 0.0;
  unsafe {
    for i in 0..n {
      let diff = fabsf(a[a_off + i] - b[b_off + i]);
      if diff > maxdiff { maxdiff = diff; }
      if fabsf(b[b_off + i]) > maxabs { maxabs = fabsf(b[b_off + i]); }
    }
  }
  let ok = maxdiff <= tol * maxabs;
  print!(label);
  if ok { print!(" OK, maxdiff = "); } else { print!(" NOT OK, maxdiff = "); }
  print(maxdiff); print!(" of "); print(maxabs); print!("\n");
  return ok;
}

fn run<const L : i32, const NH : i32, const C : i32, const C3 : i32, const C4 : i32, const VP : i32,
       const V : i32, const MAXT : i32, const B : i32, const T : i32, const BT : i32, const LBT : i32,
       const RA : i32, const LC : i32, const LC3 : i32, const LC4 : i32>(
    mode : i32, model_path : *const i8, state_path : *const i8, losses_path : *const i8,
    train_path : *const i8, val_path : *const i8, tokenizer_path : *const i8) -> i32 {
  let consistent = C3 == 3 * C && C4 == 4 * C && BT == B * T && LBT == L * BT && RA == L * B * NH * T
    && LC == L * C && LC3 == L * C3 && LC4 == L * C4;
  if !consistent {
    print!("inconsistent shape parameters\n");
    return 1;
  }
  let mut model_file = unmapped();
  if !map_file(model_path, &mut model_file) {
    print!("cannot open "); print!(model_path); print!("\n");
    return 1;
  }
  let header : *mut i32 = model_file.data;
  let ok_header = unsafe {
    header[0] == 20240326 && header[1] == 3 && header[2] == MAXT && header[3] == V
      && header[4] == L && header[5] == NH && header[6] == C && header[7] == VP
  };
  if !ok_header {
    print!("checkpoint does not match the compiled configuration\n");
    return 1;
  }
  print!("[GPT-2 on "); if mode == 0 { print!("GPU, test]\n"); } else { print!("GPU, train]\n"); }

  // Parameters, read from the checkpoint and moved to the GPU.
  let weights : *mut f32 = model_file.data;
  let mut off : i64 = 256;
  let mut wte_h = Tensor<f32, [VP, C]>::uninit();
  off = load<VP, C>(&mut wte_h, weights, off);
  let mut wte = transfer(wte_h, Memory::GPU_HBM);
  let mut wpe_h = Tensor<f32, [MAXT, C]>::uninit();
  off = load<MAXT, C>(&mut wpe_h, weights, off);
  let mut wpe = transfer(wpe_h, Memory::GPU_HBM);
  let mut ln1w_h = Tensor<f32, [LC, 1]>::uninit();
  off = load<LC, 1>(&mut ln1w_h, weights, off);
  let mut ln1w = transfer(ln1w_h, Memory::GPU_HBM);
  let mut ln1b_h = Tensor<f32, [LC, 1]>::uninit();
  off = load<LC, 1>(&mut ln1b_h, weights, off);
  let mut ln1b = transfer(ln1b_h, Memory::GPU_HBM);
  let mut qkvw_h = Tensor<f32, [LC3, C]>::uninit();
  off = load<LC3, C>(&mut qkvw_h, weights, off);
  let mut qkvw = transfer(qkvw_h, Memory::GPU_HBM);
  let mut qkvb_h = Tensor<f32, [LC3, 1]>::uninit();
  off = load<LC3, 1>(&mut qkvb_h, weights, off);
  let mut qkvb = transfer(qkvb_h, Memory::GPU_HBM);
  let mut attprojw_h = Tensor<f32, [LC, C]>::uninit();
  off = load<LC, C>(&mut attprojw_h, weights, off);
  let mut attprojw = transfer(attprojw_h, Memory::GPU_HBM);
  let mut attprojb_h = Tensor<f32, [LC, 1]>::uninit();
  off = load<LC, 1>(&mut attprojb_h, weights, off);
  let mut attprojb = transfer(attprojb_h, Memory::GPU_HBM);
  let mut ln2w_h = Tensor<f32, [LC, 1]>::uninit();
  off = load<LC, 1>(&mut ln2w_h, weights, off);
  let mut ln2w = transfer(ln2w_h, Memory::GPU_HBM);
  let mut ln2b_h = Tensor<f32, [LC, 1]>::uninit();
  off = load<LC, 1>(&mut ln2b_h, weights, off);
  let mut ln2b = transfer(ln2b_h, Memory::GPU_HBM);
  let mut fcw_h = Tensor<f32, [LC4, C]>::uninit();
  off = load<LC4, C>(&mut fcw_h, weights, off);
  let mut fcw = transfer(fcw_h, Memory::GPU_HBM);
  let mut fcb_h = Tensor<f32, [LC4, 1]>::uninit();
  off = load<LC4, 1>(&mut fcb_h, weights, off);
  let mut fcb = transfer(fcb_h, Memory::GPU_HBM);
  let mut fcprojw_h = Tensor<f32, [LC, C4]>::uninit();
  off = load<LC, C4>(&mut fcprojw_h, weights, off);
  let mut fcprojw = transfer(fcprojw_h, Memory::GPU_HBM);
  let mut fcprojb_h = Tensor<f32, [LC, 1]>::uninit();
  off = load<LC, 1>(&mut fcprojb_h, weights, off);
  let mut fcprojb = transfer(fcprojb_h, Memory::GPU_HBM);
  let mut lnfw_h = Tensor<f32, [C, 1]>::uninit();
  off = load<C, 1>(&mut lnfw_h, weights, off);
  let mut lnfw = transfer(lnfw_h, Memory::GPU_HBM);
  let mut lnfb_h = Tensor<f32, [C, 1]>::uninit();
  off = load<C, 1>(&mut lnfb_h, weights, off);
  let mut lnfb = transfer(lnfb_h, Memory::GPU_HBM);
  // Gradients and AdamW moments, one tensor per parameter tensor.
  let d_wte_h = Tensor<f32, [VP, C]>::uninit();
  let mut d_wte = transfer(d_wte_h, Memory::GPU_HBM);
  let d_wpe_h = Tensor<f32, [MAXT, C]>::uninit();
  let mut d_wpe = transfer(d_wpe_h, Memory::GPU_HBM);
  let d_ln1w_h = Tensor<f32, [LC, 1]>::uninit();
  let mut d_ln1w = transfer(d_ln1w_h, Memory::GPU_HBM);
  let d_ln1b_h = Tensor<f32, [LC, 1]>::uninit();
  let mut d_ln1b = transfer(d_ln1b_h, Memory::GPU_HBM);
  let d_qkvw_h = Tensor<f32, [LC3, C]>::uninit();
  let mut d_qkvw = transfer(d_qkvw_h, Memory::GPU_HBM);
  let d_qkvb_h = Tensor<f32, [LC3, 1]>::uninit();
  let mut d_qkvb = transfer(d_qkvb_h, Memory::GPU_HBM);
  let d_attprojw_h = Tensor<f32, [LC, C]>::uninit();
  let mut d_attprojw = transfer(d_attprojw_h, Memory::GPU_HBM);
  let d_attprojb_h = Tensor<f32, [LC, 1]>::uninit();
  let mut d_attprojb = transfer(d_attprojb_h, Memory::GPU_HBM);
  let d_ln2w_h = Tensor<f32, [LC, 1]>::uninit();
  let mut d_ln2w = transfer(d_ln2w_h, Memory::GPU_HBM);
  let d_ln2b_h = Tensor<f32, [LC, 1]>::uninit();
  let mut d_ln2b = transfer(d_ln2b_h, Memory::GPU_HBM);
  let d_fcw_h = Tensor<f32, [LC4, C]>::uninit();
  let mut d_fcw = transfer(d_fcw_h, Memory::GPU_HBM);
  let d_fcb_h = Tensor<f32, [LC4, 1]>::uninit();
  let mut d_fcb = transfer(d_fcb_h, Memory::GPU_HBM);
  let d_fcprojw_h = Tensor<f32, [LC, C4]>::uninit();
  let mut d_fcprojw = transfer(d_fcprojw_h, Memory::GPU_HBM);
  let d_fcprojb_h = Tensor<f32, [LC, 1]>::uninit();
  let mut d_fcprojb = transfer(d_fcprojb_h, Memory::GPU_HBM);
  let d_lnfw_h = Tensor<f32, [C, 1]>::uninit();
  let mut d_lnfw = transfer(d_lnfw_h, Memory::GPU_HBM);
  let d_lnfb_h = Tensor<f32, [C, 1]>::uninit();
  let mut d_lnfb = transfer(d_lnfb_h, Memory::GPU_HBM);
  let m_wte_h = Tensor<f32, [VP, C]>::uninit();
  let mut m_wte = transfer(m_wte_h, Memory::GPU_HBM);
  let m_wpe_h = Tensor<f32, [MAXT, C]>::uninit();
  let mut m_wpe = transfer(m_wpe_h, Memory::GPU_HBM);
  let m_ln1w_h = Tensor<f32, [LC, 1]>::uninit();
  let mut m_ln1w = transfer(m_ln1w_h, Memory::GPU_HBM);
  let m_ln1b_h = Tensor<f32, [LC, 1]>::uninit();
  let mut m_ln1b = transfer(m_ln1b_h, Memory::GPU_HBM);
  let m_qkvw_h = Tensor<f32, [LC3, C]>::uninit();
  let mut m_qkvw = transfer(m_qkvw_h, Memory::GPU_HBM);
  let m_qkvb_h = Tensor<f32, [LC3, 1]>::uninit();
  let mut m_qkvb = transfer(m_qkvb_h, Memory::GPU_HBM);
  let m_attprojw_h = Tensor<f32, [LC, C]>::uninit();
  let mut m_attprojw = transfer(m_attprojw_h, Memory::GPU_HBM);
  let m_attprojb_h = Tensor<f32, [LC, 1]>::uninit();
  let mut m_attprojb = transfer(m_attprojb_h, Memory::GPU_HBM);
  let m_ln2w_h = Tensor<f32, [LC, 1]>::uninit();
  let mut m_ln2w = transfer(m_ln2w_h, Memory::GPU_HBM);
  let m_ln2b_h = Tensor<f32, [LC, 1]>::uninit();
  let mut m_ln2b = transfer(m_ln2b_h, Memory::GPU_HBM);
  let m_fcw_h = Tensor<f32, [LC4, C]>::uninit();
  let mut m_fcw = transfer(m_fcw_h, Memory::GPU_HBM);
  let m_fcb_h = Tensor<f32, [LC4, 1]>::uninit();
  let mut m_fcb = transfer(m_fcb_h, Memory::GPU_HBM);
  let m_fcprojw_h = Tensor<f32, [LC, C4]>::uninit();
  let mut m_fcprojw = transfer(m_fcprojw_h, Memory::GPU_HBM);
  let m_fcprojb_h = Tensor<f32, [LC, 1]>::uninit();
  let mut m_fcprojb = transfer(m_fcprojb_h, Memory::GPU_HBM);
  let m_lnfw_h = Tensor<f32, [C, 1]>::uninit();
  let mut m_lnfw = transfer(m_lnfw_h, Memory::GPU_HBM);
  let m_lnfb_h = Tensor<f32, [C, 1]>::uninit();
  let mut m_lnfb = transfer(m_lnfb_h, Memory::GPU_HBM);
  let v_wte_h = Tensor<f32, [VP, C]>::uninit();
  let mut v_wte = transfer(v_wte_h, Memory::GPU_HBM);
  let v_wpe_h = Tensor<f32, [MAXT, C]>::uninit();
  let mut v_wpe = transfer(v_wpe_h, Memory::GPU_HBM);
  let v_ln1w_h = Tensor<f32, [LC, 1]>::uninit();
  let mut v_ln1w = transfer(v_ln1w_h, Memory::GPU_HBM);
  let v_ln1b_h = Tensor<f32, [LC, 1]>::uninit();
  let mut v_ln1b = transfer(v_ln1b_h, Memory::GPU_HBM);
  let v_qkvw_h = Tensor<f32, [LC3, C]>::uninit();
  let mut v_qkvw = transfer(v_qkvw_h, Memory::GPU_HBM);
  let v_qkvb_h = Tensor<f32, [LC3, 1]>::uninit();
  let mut v_qkvb = transfer(v_qkvb_h, Memory::GPU_HBM);
  let v_attprojw_h = Tensor<f32, [LC, C]>::uninit();
  let mut v_attprojw = transfer(v_attprojw_h, Memory::GPU_HBM);
  let v_attprojb_h = Tensor<f32, [LC, 1]>::uninit();
  let mut v_attprojb = transfer(v_attprojb_h, Memory::GPU_HBM);
  let v_ln2w_h = Tensor<f32, [LC, 1]>::uninit();
  let mut v_ln2w = transfer(v_ln2w_h, Memory::GPU_HBM);
  let v_ln2b_h = Tensor<f32, [LC, 1]>::uninit();
  let mut v_ln2b = transfer(v_ln2b_h, Memory::GPU_HBM);
  let v_fcw_h = Tensor<f32, [LC4, C]>::uninit();
  let mut v_fcw = transfer(v_fcw_h, Memory::GPU_HBM);
  let v_fcb_h = Tensor<f32, [LC4, 1]>::uninit();
  let mut v_fcb = transfer(v_fcb_h, Memory::GPU_HBM);
  let v_fcprojw_h = Tensor<f32, [LC, C4]>::uninit();
  let mut v_fcprojw = transfer(v_fcprojw_h, Memory::GPU_HBM);
  let v_fcprojb_h = Tensor<f32, [LC, 1]>::uninit();
  let mut v_fcprojb = transfer(v_fcprojb_h, Memory::GPU_HBM);
  let v_lnfw_h = Tensor<f32, [C, 1]>::uninit();
  let mut v_lnfw = transfer(v_lnfw_h, Memory::GPU_HBM);
  let v_lnfb_h = Tensor<f32, [C, 1]>::uninit();
  let mut v_lnfb = transfer(v_lnfb_h, Memory::GPU_HBM);
  // Activations and their gradients, in llm.c's layout.
  let encoded_h = Tensor<f32, [BT, C]>::uninit();
  let mut encoded = transfer(encoded_h, Memory::GPU_HBM);
  let ln1_h = Tensor<f32, [LBT, C]>::uninit();
  let mut ln1 = transfer(ln1_h, Memory::GPU_HBM);
  let ln1_mean_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut ln1_mean = transfer(ln1_mean_h, Memory::GPU_HBM);
  let ln1_rstd_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut ln1_rstd = transfer(ln1_rstd_h, Memory::GPU_HBM);
  let qkv_h = Tensor<f32, [LBT, C3]>::uninit();
  let mut qkv = transfer(qkv_h, Memory::GPU_HBM);
  let atty_h = Tensor<f32, [LBT, C]>::uninit();
  let mut atty = transfer(atty_h, Memory::GPU_HBM);
  let preatt_h = Tensor<f32, [RA, T]>::uninit();
  let mut preatt = transfer(preatt_h, Memory::GPU_HBM);
  let att_h = Tensor<f32, [RA, T]>::uninit();
  let mut att = transfer(att_h, Memory::GPU_HBM);
  let attproj_h = Tensor<f32, [LBT, C]>::uninit();
  let mut attproj = transfer(attproj_h, Memory::GPU_HBM);
  let residual2_h = Tensor<f32, [LBT, C]>::uninit();
  let mut residual2 = transfer(residual2_h, Memory::GPU_HBM);
  let ln2_h = Tensor<f32, [LBT, C]>::uninit();
  let mut ln2 = transfer(ln2_h, Memory::GPU_HBM);
  let ln2_mean_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut ln2_mean = transfer(ln2_mean_h, Memory::GPU_HBM);
  let ln2_rstd_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut ln2_rstd = transfer(ln2_rstd_h, Memory::GPU_HBM);
  let fch_h = Tensor<f32, [LBT, C4]>::uninit();
  let mut fch = transfer(fch_h, Memory::GPU_HBM);
  let fch_gelu_h = Tensor<f32, [LBT, C4]>::uninit();
  let mut fch_gelu = transfer(fch_gelu_h, Memory::GPU_HBM);
  let fcproj_h = Tensor<f32, [LBT, C]>::uninit();
  let mut fcproj = transfer(fcproj_h, Memory::GPU_HBM);
  let residual3_h = Tensor<f32, [LBT, C]>::uninit();
  let mut residual3 = transfer(residual3_h, Memory::GPU_HBM);
  let lnf_h = Tensor<f32, [BT, C]>::uninit();
  let mut lnf = transfer(lnf_h, Memory::GPU_HBM);
  let lnf_mean_h = Tensor<f32, [BT, 1]>::uninit();
  let mut lnf_mean = transfer(lnf_mean_h, Memory::GPU_HBM);
  let lnf_rstd_h = Tensor<f32, [BT, 1]>::uninit();
  let mut lnf_rstd = transfer(lnf_rstd_h, Memory::GPU_HBM);
  let logits_h = Tensor<f32, [BT, VP]>::uninit();
  let mut logits = transfer(logits_h, Memory::GPU_HBM);
  let probs_h = Tensor<f32, [BT, VP]>::uninit();
  let mut probs = transfer(probs_h, Memory::GPU_HBM);
  let losses_h = Tensor<f32, [BT, 1]>::uninit();
  let mut losses = transfer(losses_h, Memory::GPU_HBM);
  let d_encoded_h = Tensor<f32, [BT, C]>::uninit();
  let mut d_encoded = transfer(d_encoded_h, Memory::GPU_HBM);
  let d_ln1_h = Tensor<f32, [LBT, C]>::uninit();
  let mut d_ln1 = transfer(d_ln1_h, Memory::GPU_HBM);
  let d_ln1_mean_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut d_ln1_mean = transfer(d_ln1_mean_h, Memory::GPU_HBM);
  let d_ln1_rstd_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut d_ln1_rstd = transfer(d_ln1_rstd_h, Memory::GPU_HBM);
  let d_qkv_h = Tensor<f32, [LBT, C3]>::uninit();
  let mut d_qkv = transfer(d_qkv_h, Memory::GPU_HBM);
  let d_atty_h = Tensor<f32, [LBT, C]>::uninit();
  let mut d_atty = transfer(d_atty_h, Memory::GPU_HBM);
  let d_preatt_h = Tensor<f32, [RA, T]>::uninit();
  let mut d_preatt = transfer(d_preatt_h, Memory::GPU_HBM);
  let d_att_h = Tensor<f32, [RA, T]>::uninit();
  let mut d_att = transfer(d_att_h, Memory::GPU_HBM);
  let d_attproj_h = Tensor<f32, [LBT, C]>::uninit();
  let mut d_attproj = transfer(d_attproj_h, Memory::GPU_HBM);
  let d_residual2_h = Tensor<f32, [LBT, C]>::uninit();
  let mut d_residual2 = transfer(d_residual2_h, Memory::GPU_HBM);
  let d_ln2_h = Tensor<f32, [LBT, C]>::uninit();
  let mut d_ln2 = transfer(d_ln2_h, Memory::GPU_HBM);
  let d_ln2_mean_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut d_ln2_mean = transfer(d_ln2_mean_h, Memory::GPU_HBM);
  let d_ln2_rstd_h = Tensor<f32, [LBT, 1]>::uninit();
  let mut d_ln2_rstd = transfer(d_ln2_rstd_h, Memory::GPU_HBM);
  let d_fch_h = Tensor<f32, [LBT, C4]>::uninit();
  let mut d_fch = transfer(d_fch_h, Memory::GPU_HBM);
  let d_fch_gelu_h = Tensor<f32, [LBT, C4]>::uninit();
  let mut d_fch_gelu = transfer(d_fch_gelu_h, Memory::GPU_HBM);
  let d_fcproj_h = Tensor<f32, [LBT, C]>::uninit();
  let mut d_fcproj = transfer(d_fcproj_h, Memory::GPU_HBM);
  let d_residual3_h = Tensor<f32, [LBT, C]>::uninit();
  let mut d_residual3 = transfer(d_residual3_h, Memory::GPU_HBM);
  let d_lnf_h = Tensor<f32, [BT, C]>::uninit();
  let mut d_lnf = transfer(d_lnf_h, Memory::GPU_HBM);
  let d_lnf_mean_h = Tensor<f32, [BT, 1]>::uninit();
  let mut d_lnf_mean = transfer(d_lnf_mean_h, Memory::GPU_HBM);
  let d_lnf_rstd_h = Tensor<f32, [BT, 1]>::uninit();
  let mut d_lnf_rstd = transfer(d_lnf_rstd_h, Memory::GPU_HBM);
  let d_logits_h = Tensor<f32, [BT, VP]>::uninit();
  let mut d_logits = transfer(d_logits_h, Memory::GPU_HBM);
  let d_probs_h = Tensor<f32, [BT, VP]>::uninit();
  let mut d_probs = transfer(d_probs_h, Memory::GPU_HBM);
  let d_losses_h = Tensor<f32, [BT, 1]>::uninit();
  let mut d_losses = transfer(d_losses_h, Memory::GPU_HBM);
  let in_h = Tensor<i32, [BT, 1]>::uninit();
  let mut inputs = transfer(in_h, Memory::GPU_HBM);
  let tg_h = Tensor<i32, [BT, 1]>::uninit();
  let mut targets = transfer(tg_h, Memory::GPU_HBM);

    unsafe { vx_zero_f32(d_wte.as_mut_ptr(), (VP as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_wpe.as_mut_ptr(), (MAXT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_ln1w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_ln1b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_qkvw.as_mut_ptr(), (LC3 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_qkvb.as_mut_ptr(), (LC3 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_attprojw.as_mut_ptr(), (LC as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_attprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_ln2w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_ln2b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_fcw.as_mut_ptr(), (LC4 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_fcb.as_mut_ptr(), (LC4 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_fcprojw.as_mut_ptr(), (LC as i64) * (C4 as i64)); }
    unsafe { vx_zero_f32(d_fcprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_lnfw.as_mut_ptr(), (C as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_lnfb.as_mut_ptr(), (C as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_wte.as_mut_ptr(), (VP as i64) * (C as i64)); }
    unsafe { vx_zero_f32(m_wpe.as_mut_ptr(), (MAXT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(m_ln1w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_ln1b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_qkvw.as_mut_ptr(), (LC3 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(m_qkvb.as_mut_ptr(), (LC3 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_attprojw.as_mut_ptr(), (LC as i64) * (C as i64)); }
    unsafe { vx_zero_f32(m_attprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_ln2w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_ln2b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_fcw.as_mut_ptr(), (LC4 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(m_fcb.as_mut_ptr(), (LC4 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_fcprojw.as_mut_ptr(), (LC as i64) * (C4 as i64)); }
    unsafe { vx_zero_f32(m_fcprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_lnfw.as_mut_ptr(), (C as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(m_lnfb.as_mut_ptr(), (C as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_wte.as_mut_ptr(), (VP as i64) * (C as i64)); }
    unsafe { vx_zero_f32(v_wpe.as_mut_ptr(), (MAXT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(v_ln1w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_ln1b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_qkvw.as_mut_ptr(), (LC3 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(v_qkvb.as_mut_ptr(), (LC3 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_attprojw.as_mut_ptr(), (LC as i64) * (C as i64)); }
    unsafe { vx_zero_f32(v_attprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_ln2w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_ln2b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_fcw.as_mut_ptr(), (LC4 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(v_fcb.as_mut_ptr(), (LC4 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_fcprojw.as_mut_ptr(), (LC as i64) * (C4 as i64)); }
    unsafe { vx_zero_f32(v_fcprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_lnfw.as_mut_ptr(), (C as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(v_lnfb.as_mut_ptr(), (C as i64) * (1 as i64)); }

  // Host buffers: the next batch, the losses and one row of probabilities.
  let mut host_inputs = Tensor<i32>([BT]);
  let mut host_targets = Tensor<i32>([BT]);
  let mut host_losses = Tensor<f32>([BT]);
  let mut host_probs = Tensor<f32>([VP]);
  let hin : *mut i32 = host_inputs.as_mut_ptr();
  let htg : *mut i32 = host_targets.as_mut_ptr();
  let hloss : *mut f32 = host_losses.as_mut_ptr();
  let hprobs : *mut f32 = host_probs.as_mut_ptr();

  let sqrt_hs = unsafe { sqrtf((C / NH) as f32) };
  let scale = (1.0f64 / (sqrt_hs as f64)) as f32;
  let s = gelu_scale();
  let mut mean_loss : f32 = 0.0;

  // Mode 0: the reference batch, logits, loss, gradients and ten losses.
  let mut state_file = unmapped();
  let mut losses_file = unmapped();
  let mut exact_losses = Tensor<f32>([10]);
  let mut expected_losses : *mut f32 = exact_losses.as_mut_ptr();
  // Mode 1: data, tokenizer and sampler.
  let mut train_rng = Tensor<i64>([624]);
  let mut val_rng = Tensor<i64>([624]);
  let mut train_loader = DataLoader {
    tokens: unsafe { 0 as *mut u16 }, num_tokens: 0, B: 0, T: 0, num_samples: 0, current_sample: 0,
    should_shuffle: false, indices: unsafe { 0 as *mut i32 },
    rng_state: unsafe { 0 as *mut i64 }, rng_left: 1, rng_next: 0,
    inputs: unsafe { 0 as *mut i32 }, targets: unsafe { 0 as *mut i32 }
  };
  let mut val_loader = DataLoader {
    tokens: unsafe { 0 as *mut u16 }, num_tokens: 0, B: 0, T: 0, num_samples: 0, current_sample: 0,
    should_shuffle: false, indices: unsafe { 0 as *mut i32 },
    rng_state: unsafe { 0 as *mut i64 }, rng_left: 1, rng_next: 0,
    inputs: unsafe { 0 as *mut i32 }, targets: unsafe { 0 as *mut i32 }
  };
  let mut tokenizer = Tokenizer {
    bytes: unsafe { 0 as *mut u8 }, offsets: unsafe { 0 as *mut i64 }, vocab_size: 0,
    eot_token: 0, init_ok: false
  };
  let mut rng = Xorshift { s: 1337u64 };
  let mut gen_tokens = Tensor<i32>([BT]);
  let gen : *mut i32 = gen_tokens.as_mut_ptr();

  let mut last_step = 40;
  if mode == 2 { last_step = 4; }
  if mode == 0 {
    last_step = 9;
    if !map_file(state_path, &mut state_file) || !map_file(losses_path, &mut losses_file) {
      print!("cannot open the reference state\n");
      return 1;
    }
    let state : *mut i32 = state_file.data;
    let ok_state = unsafe { state[0] == 20240327 && state[1] == 2 && state[2] == B && state[3] == T };
    if !ok_state {
      print!("state does not match the compiled configuration\n");
      return 1;
    }
    unsafe {
      for i in 0..BT {
        hin[i] = state[256 + i];
        htg[i] = state[256 + BT + i];
      }
    }
    expected_losses = losses_file.data;
  } else {
    if !dataloader_init(&mut train_loader, train_path, B as i64, T as i64, true,
                        train_rng.as_mut_ptr(), hin, htg) {
      return 1;
    }
    if !dataloader_init(&mut val_loader, val_path, B as i64, T as i64, false,
                        val_rng.as_mut_ptr(), hin, htg) {
      return 1;
    }
    tokenizer_init(&mut tokenizer, tokenizer_path);
  }

  // Each pass of this loop runs one forward pass. Before it, the schedule picks
  // the job: 0 a validation batch, 1 a generated token, 2 a training step.
  let mut allok = true;
  let mut step : i32 = 0;
  let mut step_started = false;
  let mut val_left = 0;
  let mut val_loss : f32 = 0.0;
  let mut gen_t = 0;
  while step <= last_step {
    if !step_started && mode == 1 {
      if step % 10 == 0 {
        val_left = 5;
        val_loss = 0.0;
        dataloader_reset(&mut val_loader);
      }
      if step > 0 && step % 20 == 0 {
        unsafe {
          for i in 0..BT { gen[i] = tokenizer.eot_token; }
        }
        gen_t = 1;
      }
    }
    step_started = true;
    let mut job = 2;
    if val_left > 0 {
      job = 0;
      dataloader_next_batch(&mut val_loader);
    } else if gen_t > 0 {
      job = 1;
      unsafe {
        for i in 0..BT { hin[i] = gen[i]; }
      }
    } else if mode != 0 {
      dataloader_next_batch(&mut train_loader);
    }
    let start = phase_time(mode);
    let mut t_attn_fwd : f64 = 0.0;
    let mut t_attn_bwd : f64 = 0.0;
    unsafe {
      vx_upload_i32(inputs.as_mut_ptr(), hin, BT as i64);
      vx_upload_i32(targets.as_mut_ptr(), htg, BT as i64);
    }

    // Forward pass.
    k_encoder_forward<BT, C, VP, MAXT>(&mut encoded, &inputs, &wte, &wpe, T);
    for l in 0..L {
      let lo = l * BT;
      let lo64 = lo as i64;
      let l64 = l as i64;
      if l == 0 {
        k_layernorm_forward<LBT, BT, C, LC>(&mut ln1, &mut ln1_mean, &mut ln1_rstd, &encoded, &ln1w, &ln1b,
                                            0, l * C, lo, BT);
      } else {
        k_layernorm_forward<LBT, LBT, C, LC>(&mut ln1, &mut ln1_mean, &mut ln1_rstd, &residual3, &ln1w, &ln1b,
                                             lo - BT, l * C, lo, BT);
      }
      unsafe {
        cublas_matmul_forward(vx_dev_at(qkv.as_mut_ptr(), lo64 * (C3 as i64)), vx_dev_at(ln1.as_mut_ptr(), lo64 * (C as i64)),
                       vx_dev_at(qkvw.as_mut_ptr(), l64 * (C3 as i64) * (C as i64)), BT, C, C3);
      }
      k_add_bias<LBT, C3, LC3>(&mut qkv, &qkvb, l * C3, lo, BT);
      let a0 = phase_time(mode);
      k_attention_scores<RA, T, LBT, C3>(&mut preatt, &mut att, &qkv, NH, BT, l, scale, l * B * NH * T, B * NH * T);
      // preatt is dead from here on, so the output per head goes through it.
      k_attention_out_head<RA, T, LBT, C3>(&mut preatt, &att, &qkv, NH, BT, l, l * B * NH * T, B * NH * T);
      k_attention_out_gather<LBT, C, RA, T>(&mut atty, &preatt, NH, BT, l, lo, BT);
      t_attn_fwd = t_attn_fwd + phase_time(mode) - a0;
      unsafe {
        cublas_matmul_forward(vx_dev_at(attproj.as_mut_ptr(), lo64 * (C as i64)), vx_dev_at(atty.as_mut_ptr(), lo64 * (C as i64)),
                       vx_dev_at(attprojw.as_mut_ptr(), l64 * (C as i64) * (C as i64)), BT, C, C);
      }
      k_add_bias<LBT, C, LC>(&mut attproj, &attprojb, l * C, lo, BT);
      if l == 0 {
        k_add<LBT, C, BT, LBT>(&mut residual2, &encoded, &attproj, 0, lo, lo, BT);
      } else {
        k_add<LBT, C, LBT, LBT>(&mut residual2, &residual3, &attproj, lo - BT, lo, lo, BT);
      }
      k_layernorm_forward<LBT, LBT, C, LC>(&mut ln2, &mut ln2_mean, &mut ln2_rstd, &residual2, &ln2w, &ln2b,
                                           lo, l * C, lo, BT);
      unsafe {
        cublas_matmul_forward(vx_dev_at(fch.as_mut_ptr(), lo64 * (C4 as i64)), vx_dev_at(ln2.as_mut_ptr(), lo64 * (C as i64)),
                       vx_dev_at(fcw.as_mut_ptr(), l64 * (C4 as i64) * (C as i64)), BT, C, C4);
      }
      k_add_bias<LBT, C4, LC4>(&mut fch, &fcb, l * C4, lo, BT);
      k_gelu_forward<LBT, C4>(&mut fch_gelu, &fch, s, lo, BT);
      unsafe {
        cublas_matmul_forward(vx_dev_at(fcproj.as_mut_ptr(), lo64 * (C as i64)), vx_dev_at(fch_gelu.as_mut_ptr(), lo64 * (C4 as i64)),
                       vx_dev_at(fcprojw.as_mut_ptr(), l64 * (C as i64) * (C4 as i64)), BT, C4, C);
      }
      k_add_bias<LBT, C, LC>(&mut fcproj, &fcprojb, l * C, lo, BT);
      k_add<LBT, C, LBT, LBT>(&mut residual3, &residual2, &fcproj, lo, lo, lo, BT);
    }
    k_layernorm_forward<BT, LBT, C, C>(&mut lnf, &mut lnf_mean, &mut lnf_rstd, &residual3, &lnfw, &lnfb,
                                       (L - 1) * BT, 0, 0, BT);
    unsafe { cublas_matmul_forward(logits.as_mut_ptr(), lnf.as_mut_ptr(), wte.as_mut_ptr(), BT, C, VP); }
    k_softmax_forward<BT, VP>(&mut probs, &logits, V);
    if job != 1 {
      k_crossentropy_forward<BT, VP>(&mut losses, &probs, &targets);
      unsafe { vx_download_f32(hloss, 0, losses.as_mut_ptr(), BT as i64); }
      mean_loss = 0.0;
      unsafe {
        for i in 0..BT { mean_loss = mean_loss + hloss[i]; }
      }
      mean_loss = mean_loss / (BT as f32);
    }

    let t_fwd = phase_time(mode) - start;

    if job == 0 {
      val_loss = val_loss + mean_loss;
      val_left = val_left - 1;
      if val_left == 0 {
        print!("val loss "); print(val_loss / 5.0); print!("\n");
      }
    } else if job == 1 {
      if gen_t == 1 { print!("generating:\n---\n"); }
      unsafe {
        vx_download_f32(hprobs, 0, vx_dev_at(probs.as_mut_ptr(), ((gen_t - 1) as i64) * (VP as i64)), VP as i64);
      }
      let coin = random_f32(&mut rng);
      let next_token = sample_mult(hprobs, V as i64, coin);
      unsafe { gen[gen_t] = next_token; }
      if tokenizer.init_ok {
        tokenizer_print(&tokenizer, next_token);
      } else {
        print(next_token); print!(" ");
      }
      gen_t = gen_t + 1;
      if gen_t == 64 {
        gen_t = 0;
        print!("\n---\n");
      }
    } else {
      // Backward pass.
    unsafe { vx_zero_f32(d_wte.as_mut_ptr(), (VP as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_wpe.as_mut_ptr(), (MAXT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_ln1w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_ln1b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_qkvw.as_mut_ptr(), (LC3 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_qkvb.as_mut_ptr(), (LC3 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_attprojw.as_mut_ptr(), (LC as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_attprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_ln2w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_ln2b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_fcw.as_mut_ptr(), (LC4 as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_fcb.as_mut_ptr(), (LC4 as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_fcprojw.as_mut_ptr(), (LC as i64) * (C4 as i64)); }
    unsafe { vx_zero_f32(d_fcprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_lnfw.as_mut_ptr(), (C as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_lnfb.as_mut_ptr(), (C as i64) * (1 as i64)); }
    unsafe { vx_zero_f32(d_encoded.as_mut_ptr(), (BT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_ln1.as_mut_ptr(), (LBT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_qkv.as_mut_ptr(), (LBT as i64) * (C3 as i64)); }
    unsafe { vx_zero_f32(d_atty.as_mut_ptr(), (LBT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_attproj.as_mut_ptr(), (LBT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_residual2.as_mut_ptr(), (LBT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_ln2.as_mut_ptr(), (LBT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_fch.as_mut_ptr(), (LBT as i64) * (C4 as i64)); }
    unsafe { vx_zero_f32(d_fch_gelu.as_mut_ptr(), (LBT as i64) * (C4 as i64)); }
    unsafe { vx_zero_f32(d_fcproj.as_mut_ptr(), (LBT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_residual3.as_mut_ptr(), (LBT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_lnf.as_mut_ptr(), (BT as i64) * (C as i64)); }
    unsafe { vx_zero_f32(d_logits.as_mut_ptr(), (BT as i64) * (VP as i64)); }
      let dloss : f32 = 1.0 / (BT as f32);
      k_crossentropy_softmax_backward<BT, VP>(&mut d_logits, &probs, &targets, dloss, V);
      unsafe {
        cublas_matmul_backward(d_lnf.as_mut_ptr(), d_wte.as_mut_ptr(), d_logits.as_mut_ptr(), lnf.as_mut_ptr(),
                        wte.as_mut_ptr(), BT, C, VP);
      }
      k_layernorm_backward_inp<LBT, C, BT, LBT, C>(&mut d_residual3, &d_lnf, &residual3, &lnfw, &lnf_mean, &lnf_rstd,
                                                   0, (L - 1) * BT, 0, (L - 1) * BT, BT);
      k_layernorm_backward_params<C, BT, C, LBT>(&mut d_lnfw, &mut d_lnfb, &d_lnf, &residual3, &lnf_mean, &lnf_rstd,
                                                 0, 0, (L - 1) * BT, BT);
      let mut l = L - 1;
      while l >= 0 {
        let lo = l * BT;
        let lo64 = lo as i64;
        let l64 = l as i64;
        k_accumulate<LBT, C, LBT>(&mut d_residual2, &d_residual3, lo, lo, BT);
        k_accumulate<LBT, C, LBT>(&mut d_fcproj, &d_residual3, lo, lo, BT);
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_fch_gelu.as_mut_ptr(), lo64 * (C4 as i64)),
                          vx_dev_at(d_fcprojw.as_mut_ptr(), l64 * (C as i64) * (C4 as i64)),
                          vx_dev_at(d_fcproj.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(fch_gelu.as_mut_ptr(), lo64 * (C4 as i64)),
                          vx_dev_at(fcprojw.as_mut_ptr(), l64 * (C as i64) * (C4 as i64)), BT, C4, C);
        }
        k_bias_backward<LC, LBT, C>(&mut d_fcprojb, &d_fcproj, l * C, lo, BT);
        k_gelu_backward<LBT, C4>(&mut d_fch, &fch, &d_fch_gelu, s, lo, BT);
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_ln2.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(d_fcw.as_mut_ptr(), l64 * (C4 as i64) * (C as i64)),
                          vx_dev_at(d_fch.as_mut_ptr(), lo64 * (C4 as i64)),
                          vx_dev_at(ln2.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(fcw.as_mut_ptr(), l64 * (C4 as i64) * (C as i64)), BT, C, C4);
        }
        k_bias_backward<LC4, LBT, C4>(&mut d_fcb, &d_fch, l * C4, lo, BT);
        k_layernorm_backward_inp<LBT, C, LBT, LBT, LC>(&mut d_residual2, &d_ln2, &residual2, &ln2w, &ln2_mean, &ln2_rstd,
                                                       lo, lo, l * C, lo, BT);
        k_layernorm_backward_params<LC, LBT, C, LBT>(&mut d_ln2w, &mut d_ln2b, &d_ln2, &residual2, &ln2_mean, &ln2_rstd,
                                                     l * C, lo, lo, BT);
        if l == 0 {
          k_accumulate<BT, C, LBT>(&mut d_encoded, &d_residual2, lo, 0, BT);
        } else {
          k_accumulate<LBT, C, LBT>(&mut d_residual3, &d_residual2, lo, lo - BT, BT);
        }
        k_accumulate<LBT, C, LBT>(&mut d_attproj, &d_residual2, lo, lo, BT);
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_atty.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(d_attprojw.as_mut_ptr(), l64 * (C as i64) * (C as i64)),
                          vx_dev_at(d_attproj.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(atty.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(attprojw.as_mut_ptr(), l64 * (C as i64) * (C as i64)), BT, C, C);
        }
        k_bias_backward<LC, LBT, C>(&mut d_attprojb, &d_attproj, l * C, lo, BT);
        let a0 = phase_time(mode);
        k_attention_backward_scores<RA, T, LBT, C3, C>(&mut d_preatt, &mut d_att, &att, &qkv, &d_atty, NH, BT, l,
                                                       l * B * NH * T, B * NH * T);
        // d_att is dead from here on, so each part of dqkv goes through it.
        for part in 0..3 {
          k_attention_backward_part<RA, T, LBT, C3, C>(&mut d_att, &d_preatt, &att, &qkv, &d_atty, NH, BT, l, scale,
                                                       part, l * B * NH * T, B * NH * T);
          k_attention_backward_gather<LBT, C3, RA, T, C>(&mut d_qkv, &d_att, NH, BT, l, part, lo, BT);
        }
        t_attn_bwd = t_attn_bwd + phase_time(mode) - a0;
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_ln1.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(d_qkvw.as_mut_ptr(), l64 * (C3 as i64) * (C as i64)),
                          vx_dev_at(d_qkv.as_mut_ptr(), lo64 * (C3 as i64)),
                          vx_dev_at(ln1.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(qkvw.as_mut_ptr(), l64 * (C3 as i64) * (C as i64)), BT, C, C3);
        }
        k_bias_backward<LC3, LBT, C3>(&mut d_qkvb, &d_qkv, l * C3, lo, BT);
        if l == 0 {
          k_layernorm_backward_inp<BT, C, LBT, BT, LC>(&mut d_encoded, &d_ln1, &encoded, &ln1w, &ln1_mean, &ln1_rstd,
                                                       lo, 0, l * C, 0, BT);
          k_layernorm_backward_params<LC, LBT, C, BT>(&mut d_ln1w, &mut d_ln1b, &d_ln1, &encoded, &ln1_mean, &ln1_rstd,
                                                      l * C, lo, 0, BT);
        } else {
          k_layernorm_backward_inp<LBT, C, LBT, LBT, LC>(&mut d_residual3, &d_ln1, &residual3, &ln1w, &ln1_mean, &ln1_rstd,
                                                         lo, lo - BT, l * C, lo - BT, BT);
          k_layernorm_backward_params<LC, LBT, C, LBT>(&mut d_ln1w, &mut d_ln1b, &d_ln1, &residual3, &ln1_mean, &ln1_rstd,
                                                       l * C, lo, lo - BT, BT);
        }
        l = l - 1;
      }
      k_encoder_backward_wte<VP, C, BT>(&mut d_wte, &d_encoded, &inputs);
      k_encoder_backward_wpe<MAXT, C, BT>(&mut d_wpe, &d_encoded, T);
      let t_bwd = phase_time(mode) - start - t_fwd;

      if mode == 0 && step == 0 {
        // Logits, loss and every gradient against the reference.
        let BT64 = BT as i64;
        let V64 = V as i64;
        let VP64 = VP as i64;
        let expected : *mut f32 = state_file.data;
        let logits_base = 256 + 2 * BT64;
        let expected_loss = unsafe { expected[256 + 2 * BT64 + BT64 * V64] };
        let grads_base = 256 + 2 * BT64 + BT64 * V64 + 1;
        let mut logits_h = Tensor<f32>([BT * VP]);
        let lh : *mut f32 = logits_h.as_mut_ptr();
        unsafe { vx_download_f32(lh, 0, logits.as_mut_ptr(), BT64 * VP64); }
        let mut lmax : f32 = 0.0;
        unsafe {
          for bt in 0..BT64 {
            for vi in 0..V64 {
              let diff = fabsf(expected[logits_base + bt * V64 + vi] - lh[bt * VP64 + vi]);
              if diff > lmax { lmax = diff; }
            }
          }
        }
        let logits_ok = lmax <= 0.0001;
        if logits_ok { print!("OK (LOGITS), max_diff = "); } else { print!("NOT OK (LOGITS), max_diff = "); }
        print(lmax); print!("\n");
        allok = allok && logits_ok;
        let loss_ok = unsafe { fabsf(mean_loss - expected_loss) } <= 0.0001;
        if loss_ok { print!("LOSS OK: "); } else { print!("LOSS MISMATCH: "); }
        print(mean_loss); print!(" "); print(expected_loss); print!("\n");
        allok = allok && loss_ok;

        let mut grads_h = Tensor<f32>([VP * C + MAXT * C + L * (12 * C * C + 13 * C) + 2 * C]);
        let host_grads : *mut f32 = grads_h.as_mut_ptr();
        let mut goff : i64 = 0;
        let tol : f32 = 0.001;
        unsafe { vx_download_f32(host_grads, goff, d_wte.as_mut_ptr(), (VP as i64) * (C as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (V as i64) * (C as i64), tol, "dwte") && allok;
        goff = goff + (VP as i64) * (C as i64);
        unsafe { vx_download_f32(host_grads, goff, d_wpe.as_mut_ptr(), (MAXT as i64) * (C as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (MAXT as i64) * (C as i64), tol, "dwpe") && allok;
        goff = goff + (MAXT as i64) * (C as i64);
        unsafe { vx_download_f32(host_grads, goff, d_ln1w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (1 as i64), tol, "dln1w") && allok;
        goff = goff + (LC as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_ln1b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (1 as i64), tol, "dln1b") && allok;
        goff = goff + (LC as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_qkvw.as_mut_ptr(), (LC3 as i64) * (C as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC3 as i64) * (C as i64), tol, "dqkvw") && allok;
        goff = goff + (LC3 as i64) * (C as i64);
        unsafe { vx_download_f32(host_grads, goff, d_qkvb.as_mut_ptr(), (LC3 as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC3 as i64) * (1 as i64), tol, "dqkvb") && allok;
        goff = goff + (LC3 as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_attprojw.as_mut_ptr(), (LC as i64) * (C as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (C as i64), tol, "dattprojw") && allok;
        goff = goff + (LC as i64) * (C as i64);
        unsafe { vx_download_f32(host_grads, goff, d_attprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (1 as i64), tol, "dattprojb") && allok;
        goff = goff + (LC as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_ln2w.as_mut_ptr(), (LC as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (1 as i64), tol, "dln2w") && allok;
        goff = goff + (LC as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_ln2b.as_mut_ptr(), (LC as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (1 as i64), tol, "dln2b") && allok;
        goff = goff + (LC as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_fcw.as_mut_ptr(), (LC4 as i64) * (C as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC4 as i64) * (C as i64), tol, "dfcw") && allok;
        goff = goff + (LC4 as i64) * (C as i64);
        unsafe { vx_download_f32(host_grads, goff, d_fcb.as_mut_ptr(), (LC4 as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC4 as i64) * (1 as i64), tol, "dfcb") && allok;
        goff = goff + (LC4 as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_fcprojw.as_mut_ptr(), (LC as i64) * (C4 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (C4 as i64), tol, "dfcprojw") && allok;
        goff = goff + (LC as i64) * (C4 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_fcprojb.as_mut_ptr(), (LC as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (LC as i64) * (1 as i64), tol, "dfcprojb") && allok;
        goff = goff + (LC as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_lnfw.as_mut_ptr(), (C as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (C as i64) * (1 as i64), tol, "dlnfw") && allok;
        goff = goff + (C as i64) * (1 as i64);
        unsafe { vx_download_f32(host_grads, goff, d_lnfb.as_mut_ptr(), (C as i64) * (1 as i64)); }
        allok = check_close(host_grads, goff, expected, grads_base + goff, (C as i64) * (1 as i64), tol, "dlnfb") && allok;
        goff = goff + (C as i64) * (1 as i64);
      }

      // AdamW. The test uses weight decay as test_gpt2.c does; training does not.
      let mut wd : f32 = 0.0;
      if mode == 0 { wd = 0.01; }
      let lr : f32 = 0.0001;
      let beta1_t = unsafe { powf(0.9, (step + 1) as f32) };
      let beta2_t = unsafe { powf(0.999, (step + 1) as f32) };
      let c1 = 1.0 - beta1_t;
      let c2 = 1.0 - beta2_t;
    k_adamw<VP, C>(&mut wte, &d_wte, &mut m_wte, &mut v_wte, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<MAXT, C>(&mut wpe, &d_wpe, &mut m_wpe, &mut v_wpe, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, 1>(&mut ln1w, &d_ln1w, &mut m_ln1w, &mut v_ln1w, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, 1>(&mut ln1b, &d_ln1b, &mut m_ln1b, &mut v_ln1b, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC3, C>(&mut qkvw, &d_qkvw, &mut m_qkvw, &mut v_qkvw, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC3, 1>(&mut qkvb, &d_qkvb, &mut m_qkvb, &mut v_qkvb, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, C>(&mut attprojw, &d_attprojw, &mut m_attprojw, &mut v_attprojw, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, 1>(&mut attprojb, &d_attprojb, &mut m_attprojb, &mut v_attprojb, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, 1>(&mut ln2w, &d_ln2w, &mut m_ln2w, &mut v_ln2w, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, 1>(&mut ln2b, &d_ln2b, &mut m_ln2b, &mut v_ln2b, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC4, C>(&mut fcw, &d_fcw, &mut m_fcw, &mut v_fcw, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC4, 1>(&mut fcb, &d_fcb, &mut m_fcb, &mut v_fcb, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, C4>(&mut fcprojw, &d_fcprojw, &mut m_fcprojw, &mut v_fcprojw, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<LC, 1>(&mut fcprojb, &d_fcprojb, &mut m_fcprojb, &mut v_fcprojb, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<C, 1>(&mut lnfw, &d_lnfw, &mut m_lnfw, &mut v_lnfw, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
    k_adamw<C, 1>(&mut lnfb, &d_lnfb, &mut m_lnfb, &mut v_lnfb, lr, 0.9, 0.999, 0.00000001, wd, c1, c2);
      unsafe { vx_synchronize(); }
      let elapsed_ms = (unix_timestamp() - start) * 1000.0;

      if mode == 0 {
        let expected_step_loss = unsafe { expected_losses[step] };
        let step_ok = unsafe { fabsf(expected_step_loss - mean_loss) } <= 0.0001;
        allok = allok && step_ok;
        print!("step "); print(step); print!(": loss "); print(mean_loss);
        print!(" (took "); print(elapsed_ms); print!(" ms) OK = ");
        if step_ok { print!("1\n"); } else { print!("0\n"); }
      } else {
        print!("step "); print(step); print!(": train loss "); print(mean_loss);
        print!(" (took "); print(elapsed_ms); print!(" ms)\n");
        if mode == 2 {
          print!("  forward "); print(t_fwd * 1000.0); print!(" ms, attention "); print(t_attn_fwd * 1000.0);
          print!(" ms; backward "); print(t_bwd * 1000.0); print!(" ms, attention "); print(t_attn_bwd * 1000.0);
          print!(" ms\n");
        }
      }
      step = step + 1;
      step_started = false;
    }
  }

  if mode == 0 {
    if allok {
      print!("overall okay: 1\n");
      return 0;
    }
    print!("overall okay: 0\n");
    return 1;
  }
  return 0;
}
