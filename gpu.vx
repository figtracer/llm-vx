// GPT-2 kernels for the GPU, ported from gpt2.vx. Matrix multiplications go
// to cuBLAS, as in llm.c's train_gpt2_fp32.cu. Every other kernel is a Vx
// `spawn` block.
//
// Vx runs a `spawn` loop in parallel only when each write's first index is the
// loop variable. So every tensor here is 2-D (rows, columns) in llm.c's memory
// order, each kernel loops over the rows of the tensor it writes (one GPU
// thread per row), and a kernel that updates one layer covers the whole tensor
// and skips the rows outside [lo, lo + n). Reads may use any index.
//
// Kernels run on the built-in `Topology::GPU` and data lives in `Memory::GPU_HBM`.
// Vx's CUDA runtime sends only built-in GPU topologies to a device; a topology
// declared in a machine file, as Vx's fleet files do, stays on the host. The
// machine file passed with `--machine` gives GPU_HBM its capacity.
import core::num;

extern "C" {
  // cuBLAS. Operation codes: 0 = N, 1 = T. Column-major, as cuBLAS always is.
  fn cublasSgemm_v2(handle : *mut i8, transa : i32, transb : i32, m : i32, n : i32, k : i32,
                    alpha : *mut f32, A : *mut f32 in Memory::GPU_HBM, lda : i32,
                    B : *mut f32 in Memory::GPU_HBM, ldb : i32, beta : *mut f32,
                    C : *mut f32 in Memory::GPU_HBM, ldc : i32) -> i32;
  // From gpu/shim.c: the cuBLAS handle, device pointer offsets (Vx has no
  // pointer arithmetic) and copies between host and device memory.
  fn vx_cublas() -> *mut i8;
  fn vx_dev_at(p : *mut f32 in Memory::GPU_HBM, off : i64) -> *mut f32 in Memory::GPU_HBM;
  fn vx_upload_i32(dst : *mut i32 in Memory::GPU_HBM, src : *mut i32, n : i64) -> i32;
  fn vx_download_f32(dst : *mut f32, dst_off : i64, src : *mut f32 in Memory::GPU_HBM, n : i64) -> i32;
  fn vx_synchronize() -> i32;
  fn vx_zero_f32(p : *mut f32 in Memory::GPU_HBM, n : i64) -> i32;
  fn sqrtf(x : f32) -> f32;
  fn powf(x : f32, y : f32) -> f32;
}

// sqrt(2 / pi), rounded the way llm.c's `sqrtf(2.0f / M_PI)` rounds it.
fn gelu_scale() -> f32 {
  return unsafe { sqrtf((2.0f64 / 3.141592653589793f64) as f32) };
}

// ----------------------------------------------------------------------------
// Matrix multiplications, on row-major buffers.

// out (BT, OC) = inp (BT, C) @ weight (OC, C)^T. The bias is a separate kernel.
fn cublas_matmul_forward(out : *mut f32 in Memory::GPU_HBM, inp : *mut f32 in Memory::GPU_HBM,
                  weight : *mut f32 in Memory::GPU_HBM, BT : i32, C : i32, OC : i32) -> void {
  let mut one : f32 = 1.0;
  let mut zero : f32 = 0.0;
  unsafe {
    cublasSgemm_v2(vx_cublas(), 1, 0, OC, BT, C, (&mut one) as *mut f32, weight, C, inp, C,
                   (&mut zero) as *mut f32, out, OC);
  }
}

// dinp (BT, C) += dout (BT, OC) @ weight (OC, C) and dweight (OC, C) += dout^T @ inp.
fn cublas_matmul_backward(dinp : *mut f32 in Memory::GPU_HBM, dweight : *mut f32 in Memory::GPU_HBM,
                   dout : *mut f32 in Memory::GPU_HBM, inp : *mut f32 in Memory::GPU_HBM,
                   weight : *mut f32 in Memory::GPU_HBM, BT : i32, C : i32, OC : i32) -> void {
  // alpha and beta are both 1: accumulate, as the CPU kernels do. Vx allows one
  // mutable borrow per local, so each argument gets its own.
  let mut alpha1 : f32 = 1.0;
  let mut beta1 : f32 = 1.0;
  let mut alpha2 : f32 = 1.0;
  let mut beta2 : f32 = 1.0;
  unsafe {
    cublasSgemm_v2(vx_cublas(), 0, 0, C, BT, OC, (&mut alpha1) as *mut f32, weight, C, dout, OC,
                   (&mut beta1) as *mut f32, dinp, C);
    cublasSgemm_v2(vx_cublas(), 0, 1, C, OC, BT, (&mut alpha2) as *mut f32, inp, C, dout, OC,
                   (&mut beta2) as *mut f32, dweight, C);
  }
}

// ----------------------------------------------------------------------------
// Kernels.

fn k_encoder_forward<const BT : i32, const C : i32, const VP : i32, const MAXT : i32>(
    out : &mut Tensor<f32, [BT, C], Memory::GPU_HBM>, inp : &Tensor<i32, [BT, 1], Memory::GPU_HBM>,
    wte : &Tensor<f32, [VP, C], Memory::GPU_HBM>, wpe : &Tensor<f32, [MAXT, C], Memory::GPU_HBM>,
    T : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..BT {
      let ix = inp[r][0];
      let t = r % T;
      for i in 0..C { out[r][i] = wte[ix][i] + wpe[t][i]; }
    }
  }
  return;
}

// Rows [lo, lo + n) of `out` from rows [in_lo, in_lo + n) of `inp`, with the
// layer's weights at [w_lo, w_lo + C).
fn k_layernorm_forward<const R : i32, const RI : i32, const C : i32, const RW : i32>(
    out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, mean : &mut Tensor<f32, [R, 1], Memory::GPU_HBM>,
    rstd : &mut Tensor<f32, [R, 1], Memory::GPU_HBM>, inp : &Tensor<f32, [RI, C], Memory::GPU_HBM>,
    weight : &Tensor<f32, [RW, 1], Memory::GPU_HBM>, bias : &Tensor<f32, [RW, 1], Memory::GPU_HBM>,
    in_lo : i32, w_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let x = in_lo + r - lo;
        let mut m : f32 = 0.0;
        for i in 0..C { m = m + inp[x][i]; }
        m = m / (C as f32);
        let mut v : f32 = 0.0;
        for i in 0..C {
          let xshift = inp[x][i] - m;
          v = v + xshift * xshift;
        }
        v = v / (C as f32);
        let s = 1.0 / (v + 0.00001).sqrt();
        for i in 0..C {
          let nrm = s * (inp[x][i] - m);
          out[r][i] = nrm * weight[w_lo + i][0] + bias[w_lo + i][0];
        }
        mean[r][0] = m;
        rstd[r][0] = s;
      }
    }
  }
  return;
}

fn k_add_bias<const R : i32, const OC : i32, const RB : i32>(
    out : &mut Tensor<f32, [R, OC], Memory::GPU_HBM>, bias : &Tensor<f32, [RB, 1], Memory::GPU_HBM>,
    b_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for o in 0..OC { out[r][o] = out[r][o] + bias[b_lo + o][0]; }
      }
    }
  }
  return;
}

// Attention rows are (l, b, h, t) and qkv rows are (l, b, t). Each thread
// takes one query position: scores, causal softmax, and the masked tail.
fn k_attention_scores<const RA : i32, const T : i32, const R : i32, const C3 : i32>(
    preatt : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, att : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>,
    qkv : &Tensor<f32, [R, C3], Memory::GPU_HBM>, NH : i32, BT : i32, l : i32, scale : f32,
    lo : i32, n : i32) -> void {
  let C = C3 / 3;
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..RA {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / (NH * T);
        let h = (rr / T) % NH;
        let t = rr % T;
        let q = l * BT + b * T + t;
        let mut maxval : f32 = -10000.0;
        for t2 in 0..(t + 1) {
          let k = l * BT + b * T + t2;
          let mut val : f32 = 0.0;
          for i in 0..hs { val = val + qkv[q][h * hs + i] * qkv[k][C + h * hs + i]; }
          val = val * scale;
          if val > maxval { maxval = val; }
          preatt[r][t2] = val;
        }
        let mut expsum : f32 = 0.0;
        for t2 in 0..(t + 1) {
          let expv = (preatt[r][t2] - maxval).exp();
          expsum = expsum + expv;
          att[r][t2] = expv;
        }
        let mut expsum_inv : f32 = 0.0;
        if expsum != 0.0 { expsum_inv = 1.0 / expsum; }
        for t2 in 0..T {
          if t2 <= t {
            att[r][t2] = att[r][t2] * expsum_inv;
          } else {
            att[r][t2] = 0.0;
          }
        }
      }
    }
  }
  return;
}

// The attention output of one (batch, head, position): out[i] = the sum over
// t2 <= t of att[t2] * value[t2][i], into the first hs columns of that row of
// `scratch`. The caller passes preatt, which nothing reads once att is computed.
// One thread per row of att, and 16 outputs per pass over the row, so the row
// is read hs / 16 times. hs must be a multiple of 16.
fn k_attention_out_head<const RA : i32, const T : i32, const R : i32, const C3 : i32>(
    scratch : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, att : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
    qkv : &Tensor<f32, [R, C3], Memory::GPU_HBM>, NH : i32, BT : i32, l : i32, lo : i32, n : i32) -> void {
  let C = C3 / 3;
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..RA {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / (NH * T);
        let h = (rr / T) % NH;
        let t = rr % T;
        let row0 = l * BT + b * T;
        for chunk in 0..(hs / 16) {
          let i0 = chunk * 16;
          let c = C * 2 + h * hs + i0;
          let mut s0 : f32 = 0.0;
          let mut s1 : f32 = 0.0;
          let mut s2 : f32 = 0.0;
          let mut s3 : f32 = 0.0;
          let mut s4 : f32 = 0.0;
          let mut s5 : f32 = 0.0;
          let mut s6 : f32 = 0.0;
          let mut s7 : f32 = 0.0;
          let mut s8 : f32 = 0.0;
          let mut s9 : f32 = 0.0;
          let mut s10 : f32 = 0.0;
          let mut s11 : f32 = 0.0;
          let mut s12 : f32 = 0.0;
          let mut s13 : f32 = 0.0;
          let mut s14 : f32 = 0.0;
          let mut s15 : f32 = 0.0;
          for t2 in 0..(t + 1) {
            let w = att[r][t2];
            let v = row0 + t2;
            s0 = s0 + w * qkv[v][c];
            s1 = s1 + w * qkv[v][c + 1];
            s2 = s2 + w * qkv[v][c + 2];
            s3 = s3 + w * qkv[v][c + 3];
            s4 = s4 + w * qkv[v][c + 4];
            s5 = s5 + w * qkv[v][c + 5];
            s6 = s6 + w * qkv[v][c + 6];
            s7 = s7 + w * qkv[v][c + 7];
            s8 = s8 + w * qkv[v][c + 8];
            s9 = s9 + w * qkv[v][c + 9];
            s10 = s10 + w * qkv[v][c + 10];
            s11 = s11 + w * qkv[v][c + 11];
            s12 = s12 + w * qkv[v][c + 12];
            s13 = s13 + w * qkv[v][c + 13];
            s14 = s14 + w * qkv[v][c + 14];
            s15 = s15 + w * qkv[v][c + 15];
          }
          scratch[r][i0] = s0;
          scratch[r][i0 + 1] = s1;
          scratch[r][i0 + 2] = s2;
          scratch[r][i0 + 3] = s3;
          scratch[r][i0 + 4] = s4;
          scratch[r][i0 + 5] = s5;
          scratch[r][i0 + 6] = s6;
          scratch[r][i0 + 7] = s7;
          scratch[r][i0 + 8] = s8;
          scratch[r][i0 + 9] = s9;
          scratch[r][i0 + 10] = s10;
          scratch[r][i0 + 11] = s11;
          scratch[r][i0 + 12] = s12;
          scratch[r][i0 + 13] = s13;
          scratch[r][i0 + 14] = s14;
          scratch[r][i0 + 15] = s15;
        }
      }
    }
  }
  return;
}

// out = the attention output, for rows [lo, lo + n) of out: each position
// collects its heads from `scratch`.
fn k_attention_out_gather<const R : i32, const C : i32, const RA : i32, const T : i32>(
    out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, scratch : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
    NH : i32, BT : i32, l : i32, lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / T;
        let t = rr % T;
        for h in 0..NH {
          let a = l * BT * NH + b * NH * T + h * T + t;
          for i in 0..hs { out[r][h * hs + i] = scratch[a][i]; }
        }
      }
    }
  }
  return;
}

// out = a + b, row by row: rows [lo, lo + n) of out, from [a_lo, ..) and [b_lo, ..).
fn k_add<const R : i32, const C : i32, const RA : i32, const RB : i32>(
    out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, a : &Tensor<f32, [RA, C], Memory::GPU_HBM>,
    b : &Tensor<f32, [RB, C], Memory::GPU_HBM>, a_lo : i32, b_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C { out[r][c] = a[a_lo + r - lo][c] + b[b_lo + r - lo][c]; }
      }
    }
  }
  return;
}

// dst += src, row by row: rows [lo, lo + n) of dst, from [src_lo, ..) of src.
fn k_accumulate<const R : i32, const C : i32, const RS : i32>(
    dst : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, src : &Tensor<f32, [RS, C], Memory::GPU_HBM>,
    src_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C { dst[r][c] = dst[r][c] + src[src_lo + r - lo][c]; }
      }
    }
  }
  return;
}

fn k_gelu_forward<const R : i32, const C : i32>(out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    inp : &Tensor<f32, [R, C], Memory::GPU_HBM>, s : f32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C {
          let x = inp[r][c];
          let cube = 0.044715 * x * x * x;
          out[r][c] = 0.5 * x * (1.0 + (s * (x + cube)).tanh());
        }
      }
    }
  }
  return;
}

fn k_softmax_forward<const BT : i32, const VP : i32>(probs : &mut Tensor<f32, [BT, VP], Memory::GPU_HBM>,
    logits : &Tensor<f32, [BT, VP], Memory::GPU_HBM>, V : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..BT {
      let mut maxval : f32 = -10000.0;
      for i in 0..V {
        if logits[r][i] > maxval { maxval = logits[r][i]; }
      }
      let mut sum : f32 = 0.0;
      for i in 0..V {
        let e = (logits[r][i] - maxval).exp();
        probs[r][i] = e;
        sum = sum + e;
      }
      for i in 0..VP {
        if i < V {
          probs[r][i] = probs[r][i] / sum;
        } else {
          probs[r][i] = 0.0;
        }
      }
    }
  }
  return;
}

fn k_crossentropy_forward<const BT : i32, const VP : i32>(losses : &mut Tensor<f32, [BT, 1], Memory::GPU_HBM>,
    probs : &Tensor<f32, [BT, VP], Memory::GPU_HBM>, targets : &Tensor<i32, [BT, 1], Memory::GPU_HBM>) -> void {
  spawn on(Topology::GPU) {
    for r in 0..BT {
      losses[r][0] = 0.0 - probs[r][targets[r][0]].ln();
    }
  }
  return;
}

fn k_crossentropy_softmax_backward<const BT : i32, const VP : i32>(
    dlogits : &mut Tensor<f32, [BT, VP], Memory::GPU_HBM>, probs : &Tensor<f32, [BT, VP], Memory::GPU_HBM>,
    targets : &Tensor<i32, [BT, 1], Memory::GPU_HBM>, dloss : f32, V : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..BT {
      let ix = targets[r][0];
      for i in 0..V {
        let mut indicator : f32 = 0.0;
        if i == ix { indicator = 1.0; }
        dlogits[r][i] = dlogits[r][i] + (probs[r][i] - indicator) * dloss;
      }
    }
  }
  return;
}

// dbias[b_lo + o] += the column sum of dout rows [d_lo, d_lo + BT), one thread per output.
fn k_bias_backward<const RB : i32, const R : i32, const OC : i32>(
    dbias : &mut Tensor<f32, [RB, 1], Memory::GPU_HBM>, dout : &Tensor<f32, [R, OC], Memory::GPU_HBM>,
    b_lo : i32, d_lo : i32, BT : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..RB {
      if r >= b_lo && r < b_lo + OC {
        let o = r - b_lo;
        let mut sum : f32 = 0.0;
        for bt in 0..BT { sum = sum + dout[d_lo + bt][o]; }
        dbias[r][0] = dbias[r][0] + sum;
      }
    }
  }
  return;
}

// dinp rows [lo, lo + n) from rows [d_lo, ..) of dout, inp, mean and rstd.
fn k_layernorm_backward_inp<const R : i32, const C : i32, const RD : i32, const RI : i32, const RW : i32>(
    dinp : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, dout : &Tensor<f32, [RD, C], Memory::GPU_HBM>,
    inp : &Tensor<f32, [RI, C], Memory::GPU_HBM>, weight : &Tensor<f32, [RW, 1], Memory::GPU_HBM>,
    mean : &Tensor<f32, [RD, 1], Memory::GPU_HBM>, rstd : &Tensor<f32, [RD, 1], Memory::GPU_HBM>,
    d_lo : i32, in_lo : i32, w_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let d = d_lo + r - lo;
        let x = in_lo + r - lo;
        let mean_bt = mean[d][0];
        let rstd_bt = rstd[d][0];
        let mut dnorm_mean : f32 = 0.0;
        let mut dnorm_norm_mean : f32 = 0.0;
        for i in 0..C {
          let norm_bti = (inp[x][i] - mean_bt) * rstd_bt;
          let dnorm_i = weight[w_lo + i][0] * dout[d][i];
          dnorm_mean = dnorm_mean + dnorm_i;
          dnorm_norm_mean = dnorm_norm_mean + dnorm_i * norm_bti;
        }
        dnorm_mean = dnorm_mean / (C as f32);
        dnorm_norm_mean = dnorm_norm_mean / (C as f32);
        for i in 0..C {
          let norm_bti = (inp[x][i] - mean_bt) * rstd_bt;
          let dnorm_i = weight[w_lo + i][0] * dout[d][i];
          let mut dval : f32 = 0.0;
          dval = dval + dnorm_i;
          dval = dval - dnorm_mean;
          dval = dval - norm_bti * dnorm_norm_mean;
          dval = dval * rstd_bt;
          dinp[r][i] = dinp[r][i] + dval;
        }
      }
    }
  }
  return;
}

// dweight and dbias at [w_lo, w_lo + C): column sums over BT rows from d_lo.
fn k_layernorm_backward_params<const RW : i32, const RD : i32, const C : i32, const RI : i32>(
    dweight : &mut Tensor<f32, [RW, 1], Memory::GPU_HBM>, dbias : &mut Tensor<f32, [RW, 1], Memory::GPU_HBM>,
    dout : &Tensor<f32, [RD, C], Memory::GPU_HBM>, inp : &Tensor<f32, [RI, C], Memory::GPU_HBM>,
    mean : &Tensor<f32, [RD, 1], Memory::GPU_HBM>, rstd : &Tensor<f32, [RD, 1], Memory::GPU_HBM>,
    w_lo : i32, d_lo : i32, in_lo : i32, BT : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..RW {
      if r >= w_lo && r < w_lo + C {
        let i = r - w_lo;
        let mut dw : f32 = dweight[r][0];
        let mut db : f32 = dbias[r][0];
        for bt in 0..BT {
          let norm_bti = (inp[in_lo + bt][i] - mean[d_lo + bt][0]) * rstd[d_lo + bt][0];
          db = db + dout[d_lo + bt][i];
          dw = dw + norm_bti * dout[d_lo + bt][i];
        }
        dweight[r][0] = dw;
        dbias[r][0] = db;
      }
    }
  }
  return;
}

// sech^2 is written as 1 - tanh^2: Vx kernels have tanh but not cosh.
fn k_gelu_backward<const R : i32, const C : i32>(dinp : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    inp : &Tensor<f32, [R, C], Memory::GPU_HBM>, dout : &Tensor<f32, [R, C], Memory::GPU_HBM>, s : f32,
    lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C {
          let x = inp[r][c];
          let cube = 0.044715 * x * x * x;
          let tanh_out = (s * (x + cube)).tanh();
          let sech_out = 1.0 - tanh_out * tanh_out;
          let local_grad = 0.5 * (1.0 + tanh_out) + x * 0.5 * sech_out * s * (1.0 + 3.0 * 0.044715 * x * x);
          dinp[r][c] = dinp[r][c] + local_grad * dout[r][c];
        }
      }
    }
  }
  return;
}

// For one query position: datt from the values, then dpreatt through the softmax.
// Both are assigned, not accumulated, so neither needs zeroing before a step.
// Entries above the diagonal stay as they are; nothing reads them.
fn k_attention_backward_scores<const RA : i32, const T : i32, const R : i32, const C3 : i32, const C : i32>(
    dpreatt : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, datt : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>,
    att : &Tensor<f32, [RA, T], Memory::GPU_HBM>, qkv : &Tensor<f32, [R, C3], Memory::GPU_HBM>,
    dout : &Tensor<f32, [R, C], Memory::GPU_HBM>, NH : i32, BT : i32, l : i32, lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..RA {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / (NH * T);
        let h = (rr / T) % NH;
        let t = rr % T;
        let o = l * BT + b * T + t;
        for t2 in 0..(t + 1) {
          let v = l * BT + b * T + t2;
          let mut acc : f32 = 0.0;
          for i in 0..hs { acc = acc + qkv[v][C * 2 + h * hs + i] * dout[o][h * hs + i]; }
          datt[r][t2] = acc;
        }
        // Softmax backward in O(T), as llm.c's CUDA version computes it:
        // dpreatt[t3] = att[t3] * (datt[t3] - sum over t2 of att[t2] * datt[t2]).
        // llm.c's CPU code sums the O(T^2) form, which differs only in rounding
        // and costs about T^3 / 3 multiply-adds per head.
        let mut dot : f32 = 0.0;
        for t2 in 0..(t + 1) { dot = dot + att[r][t2] * datt[r][t2]; }
        for t3 in 0..(t + 1) {
          dpreatt[r][t3] = att[r][t3] * (datt[r][t3] - dot);
        }
      }
    }
  }
  return;
}

// One part of dqkv (0 dquery, 1 dkey, 2 dvalue) for one (batch, head, position),
// into the first hs columns of that row of `scratch`. The caller passes datt,
// which no later kernel reads. One thread per row of att: twelve times as many
// threads as one per position. dquery sums over the keys before the position,
// dkey and dvalue over the queries at or after it. The second loop runs over
// every query and skips the earlier ones, so a warp reads one row of att and
// dpreatt at a time. 16 outputs per pass, so each row or column is read hs / 16
// times. hs must be a multiple of 16.
fn k_attention_backward_part<const RA : i32, const T : i32, const R : i32, const C3 : i32, const C : i32>(
    scratch : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, dpreatt : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
    att : &Tensor<f32, [RA, T], Memory::GPU_HBM>, qkv : &Tensor<f32, [R, C3], Memory::GPU_HBM>,
    dout : &Tensor<f32, [R, C], Memory::GPU_HBM>, NH : i32, BT : i32, l : i32, scale : f32, part : i32,
    lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..RA {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / (NH * T);
        let h = (rr / T) % NH;
        let t = rr % T;
        let arow = lo + b * NH * T + h * T;
        let row0 = l * BT + b * T;
        for chunk in 0..(hs / 16) {
          let i0 = chunk * 16;
          let mut s0 : f32 = 0.0;
          let mut s1 : f32 = 0.0;
          let mut s2 : f32 = 0.0;
          let mut s3 : f32 = 0.0;
          let mut s4 : f32 = 0.0;
          let mut s5 : f32 = 0.0;
          let mut s6 : f32 = 0.0;
          let mut s7 : f32 = 0.0;
          let mut s8 : f32 = 0.0;
          let mut s9 : f32 = 0.0;
          let mut s10 : f32 = 0.0;
          let mut s11 : f32 = 0.0;
          let mut s12 : f32 = 0.0;
          let mut s13 : f32 = 0.0;
          let mut s14 : f32 = 0.0;
          let mut s15 : f32 = 0.0;
          if part == 0 {
            let c = C + h * hs + i0;
            for t2 in 0..(t + 1) {
              let d = dpreatt[r][t2];
              let k = row0 + t2;
              s0 = s0 + qkv[k][c] * d * scale;
              s1 = s1 + qkv[k][c + 1] * d * scale;
              s2 = s2 + qkv[k][c + 2] * d * scale;
              s3 = s3 + qkv[k][c + 3] * d * scale;
              s4 = s4 + qkv[k][c + 4] * d * scale;
              s5 = s5 + qkv[k][c + 5] * d * scale;
              s6 = s6 + qkv[k][c + 6] * d * scale;
              s7 = s7 + qkv[k][c + 7] * d * scale;
              s8 = s8 + qkv[k][c + 8] * d * scale;
              s9 = s9 + qkv[k][c + 9] * d * scale;
              s10 = s10 + qkv[k][c + 10] * d * scale;
              s11 = s11 + qkv[k][c + 11] * d * scale;
              s12 = s12 + qkv[k][c + 12] * d * scale;
              s13 = s13 + qkv[k][c + 13] * d * scale;
              s14 = s14 + qkv[k][c + 14] * d * scale;
              s15 = s15 + qkv[k][c + 15] * d * scale;
            }
          } else if part == 1 {
            let c = h * hs + i0;
            for tq in 0..T {
              if tq >= t {
                let d = dpreatt[arow + tq][t];
                let q = row0 + tq;
                s0 = s0 + qkv[q][c] * d * scale;
                s1 = s1 + qkv[q][c + 1] * d * scale;
                s2 = s2 + qkv[q][c + 2] * d * scale;
                s3 = s3 + qkv[q][c + 3] * d * scale;
                s4 = s4 + qkv[q][c + 4] * d * scale;
                s5 = s5 + qkv[q][c + 5] * d * scale;
                s6 = s6 + qkv[q][c + 6] * d * scale;
                s7 = s7 + qkv[q][c + 7] * d * scale;
                s8 = s8 + qkv[q][c + 8] * d * scale;
                s9 = s9 + qkv[q][c + 9] * d * scale;
                s10 = s10 + qkv[q][c + 10] * d * scale;
                s11 = s11 + qkv[q][c + 11] * d * scale;
                s12 = s12 + qkv[q][c + 12] * d * scale;
                s13 = s13 + qkv[q][c + 13] * d * scale;
                s14 = s14 + qkv[q][c + 14] * d * scale;
                s15 = s15 + qkv[q][c + 15] * d * scale;
              }
            }
          } else {
            let c = h * hs + i0;
            for tq in 0..T {
              if tq >= t {
                let w = att[arow + tq][t];
                let q = row0 + tq;
                s0 = s0 + w * dout[q][c];
                s1 = s1 + w * dout[q][c + 1];
                s2 = s2 + w * dout[q][c + 2];
                s3 = s3 + w * dout[q][c + 3];
                s4 = s4 + w * dout[q][c + 4];
                s5 = s5 + w * dout[q][c + 5];
                s6 = s6 + w * dout[q][c + 6];
                s7 = s7 + w * dout[q][c + 7];
                s8 = s8 + w * dout[q][c + 8];
                s9 = s9 + w * dout[q][c + 9];
                s10 = s10 + w * dout[q][c + 10];
                s11 = s11 + w * dout[q][c + 11];
                s12 = s12 + w * dout[q][c + 12];
                s13 = s13 + w * dout[q][c + 13];
                s14 = s14 + w * dout[q][c + 14];
                s15 = s15 + w * dout[q][c + 15];
              }
            }
          }
          scratch[r][i0] = s0;
          scratch[r][i0 + 1] = s1;
          scratch[r][i0 + 2] = s2;
          scratch[r][i0 + 3] = s3;
          scratch[r][i0 + 4] = s4;
          scratch[r][i0 + 5] = s5;
          scratch[r][i0 + 6] = s6;
          scratch[r][i0 + 7] = s7;
          scratch[r][i0 + 8] = s8;
          scratch[r][i0 + 9] = s9;
          scratch[r][i0 + 10] = s10;
          scratch[r][i0 + 11] = s11;
          scratch[r][i0 + 12] = s12;
          scratch[r][i0 + 13] = s13;
          scratch[r][i0 + 14] = s14;
          scratch[r][i0 + 15] = s15;
        }
      }
    }
  }
  return;
}

// dqkv += one part of it from `scratch`, for rows [lo, lo + n) of dqkv: each
// position collects its heads.
fn k_attention_backward_gather<const R : i32, const C3 : i32, const RA : i32, const T : i32, const C : i32>(
    dqkv : &mut Tensor<f32, [R, C3], Memory::GPU_HBM>, scratch : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
    NH : i32, BT : i32, l : i32, part : i32, lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / T;
        let t = rr % T;
        for h in 0..NH {
          let a = l * BT * NH + b * NH * T + h * T + t;
          for i in 0..hs {
            dqkv[r][part * C + h * hs + i] = dqkv[r][part * C + h * hs + i] + scratch[a][i];
          }
        }
      }
    }
  }
  return;
}

// One thread per vocabulary row gathers that token's positions, so no two
// threads write the same row.
fn k_encoder_backward_wte<const VP : i32, const C : i32, const BT : i32>(
    dwte : &mut Tensor<f32, [VP, C], Memory::GPU_HBM>, dout : &Tensor<f32, [BT, C], Memory::GPU_HBM>,
    inp : &Tensor<i32, [BT, 1], Memory::GPU_HBM>) -> void {
  spawn on(Topology::GPU) {
    for v in 0..VP {
      for bt in 0..BT {
        if inp[bt][0] == v {
          for i in 0..C { dwte[v][i] = dwte[v][i] + dout[bt][i]; }
        }
      }
    }
  }
  return;
}

fn k_encoder_backward_wpe<const MAXT : i32, const C : i32, const BT : i32>(
    dwpe : &mut Tensor<f32, [MAXT, C], Memory::GPU_HBM>, dout : &Tensor<f32, [BT, C], Memory::GPU_HBM>,
    T : i32) -> void {
  spawn on(Topology::GPU) {
    for t in 0..MAXT {
      if t < T {
        for b in 0..(BT / T) {
          for i in 0..C { dwpe[t][i] = dwpe[t][i] + dout[b * T + t][i]; }
        }
      }
    }
  }
  return;
}

fn k_adamw<const R : i32, const C : i32>(params : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    grads : &Tensor<f32, [R, C], Memory::GPU_HBM>, ms : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    vs : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, learning_rate : f32, beta1 : f32, beta2 : f32,
    eps : f32, weight_decay : f32, beta1_correction : f32, beta2_correction : f32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      for c in 0..C {
        let param = params[r][c];
        let g = grads[r][c];
        let m = beta1 * ms[r][c] + (1.0 - beta1) * g;
        let v = beta2 * vs[r][c] + (1.0 - beta2) * g * g;
        let m_hat = m / beta1_correction;
        let v_hat = v / beta2_correction;
        ms[r][c] = m;
        vs[r][c] = v;
        params[r][c] = param - learning_rate * (m_hat / (v_hat.sqrt() + eps) + weight_decay * param);
      }
    }
  }
  return;
}
