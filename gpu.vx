// GPT-2 kernels for the GPU, ported from gpt2.vx. Matrix multiplications go
// to cuBLAS, as in llm.c's train_gpt2_fp32.cu. Every other kernel is a Vx
// `spawn` block.
//
// Vx runs a `spawn` loop in parallel only when each write's first index is the
// loop variable. So every tensor here is 2-D (rows, columns) in llm.c's memory
// order, each kernel loops over the rows of the tensor it writes (one GPU
// thread per row), and a kernel that updates one layer covers the whole tensor
// and skips the rows outside [lo, lo + n). Reads may use any index.
//
// Kernels run on the built-in `Topology::GPU` and data lives in `Memory::GPU_HBM`.
// Vx's CUDA runtime sends only built-in GPU topologies to a device; a topology
// declared in a machine file, as Vx's fleet files do, stays on the host. The
// machine file passed with `--machine` gives GPU_HBM its capacity.
import core::num;

extern "C" {
  // cuBLAS. Operation codes: 0 = N, 1 = T. Column-major, as cuBLAS always is.
  fn cublasSgemm_v2(handle : *mut i8, transa : i32, transb : i32, m : i32, n : i32, k : i32,
                    alpha : *mut f32, A : *mut f32 in Memory::GPU_HBM, lda : i32,
                    B : *mut f32 in Memory::GPU_HBM, ldb : i32, beta : *mut f32,
                    C : *mut f32 in Memory::GPU_HBM, ldc : i32) -> i32;
  // From gpu/shim.c: the cuBLAS handle, device pointer offsets (Vx has no
  // pointer arithmetic) and copies between host and device memory.
  fn vx_cublas() -> *mut i8;
  fn vx_dev_at(p : *mut f32 in Memory::GPU_HBM, off : i64) -> *mut f32 in Memory::GPU_HBM;
  fn vx_upload_i32(dst : *mut i32 in Memory::GPU_HBM, src : *mut i32, n : i64) -> i32;
  fn vx_download_f32(dst : *mut f32, dst_off : i64, src : *mut f32 in Memory::GPU_HBM, n : i64) -> i32;
  fn vx_synchronize() -> i32;
  fn vx_zero_f32(p : *mut f32 in Memory::GPU_HBM, n : i64) -> i32;
  fn sqrtf(x : f32) -> f32;
  fn powf(x : f32, y : f32) -> f32;
}

// sqrt(2 / pi), rounded the way llm.c's `sqrtf(2.0f / M_PI)` rounds it.
fn gelu_scale() -> f32 {
  return unsafe { sqrtf((2.0f64 / 3.141592653589793f64) as f32) };
}

// ----------------------------------------------------------------------------
// Matrix multiplications, on row-major buffers.

// out (BT, OC) = inp (BT, C) @ weight (OC, C)^T. The bias is a separate kernel.
fn cublas_matmul_forward(out : *mut f32 in Memory::GPU_HBM, inp : *mut f32 in Memory::GPU_HBM,
                  weight : *mut f32 in Memory::GPU_HBM, BT : i32, C : i32, OC : i32) -> void {
  let mut one : f32 = 1.0;
  let mut zero : f32 = 0.0;
  unsafe {
    cublasSgemm_v2(vx_cublas(), 1, 0, OC, BT, C, (&mut one) as *mut f32, weight, C, inp, C,
                   (&mut zero) as *mut f32, out, OC);
  }
}

// out (BT, OC) += bias (OC) in every row: a rank-1 product of the bias and a
// column of BT ones, so one cuBLAS call instead of a kernel with one thread per
// row. Each element is still out + bias.
fn cublas_add_bias(out : *mut f32 in Memory::GPU_HBM, bias : *mut f32 in Memory::GPU_HBM,
                   ones : *mut f32 in Memory::GPU_HBM, BT : i32, OC : i32) -> void {
  let mut one : f32 = 1.0;
  let mut beta : f32 = 1.0;
  unsafe {
    cublasSgemm_v2(vx_cublas(), 0, 0, OC, BT, 1, (&mut one) as *mut f32, bias, OC, ones, 1,
                   (&mut beta) as *mut f32, out, OC);
  }
}

// dinp (BT, C) += dout (BT, OC) @ weight (OC, C) and dweight (OC, C) += dout^T @ inp.
fn cublas_matmul_backward(dinp : *mut f32 in Memory::GPU_HBM, dweight : *mut f32 in Memory::GPU_HBM,
                   dout : *mut f32 in Memory::GPU_HBM, inp : *mut f32 in Memory::GPU_HBM,
                   weight : *mut f32 in Memory::GPU_HBM, BT : i32, C : i32, OC : i32) -> void {
  // alpha and beta are both 1: accumulate, as the CPU kernels do. Vx allows one
  // mutable borrow per local, so each argument gets its own.
  let mut alpha1 : f32 = 1.0;
  let mut beta1 : f32 = 1.0;
  let mut alpha2 : f32 = 1.0;
  let mut beta2 : f32 = 1.0;
  unsafe {
    cublasSgemm_v2(vx_cublas(), 0, 0, C, BT, OC, (&mut alpha1) as *mut f32, weight, C, dout, OC,
                   (&mut beta1) as *mut f32, dinp, C);
    cublasSgemm_v2(vx_cublas(), 0, 1, C, OC, BT, (&mut alpha2) as *mut f32, inp, C, dout, OC,
                   (&mut beta2) as *mut f32, dweight, C);
  }
}

// ----------------------------------------------------------------------------
// Kernels.

// t = value everywhere.
fn k_fill<const R : i32, const C : i32>(t : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, value : f32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      for c in 0..C { t[r][c] = value; }
    }
  }
  return;
}

fn k_encoder_forward<const BT : i32, const C : i32, const VP : i32, const MAXT : i32>(
    out : &mut Tensor<f32, [BT, C], Memory::GPU_HBM>, inp : &Tensor<i32, [BT, 1], Memory::GPU_HBM>,
    wte : &Tensor<f32, [VP, C], Memory::GPU_HBM>, wpe : &Tensor<f32, [MAXT, C], Memory::GPU_HBM>,
    T : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..BT {
      let ix = inp[r][0];
      let t = r % T;
      for i in 0..C { out[r][i] = wte[ix][i] + wpe[t][i]; }
    }
  }
  return;
}

// Rows [lo, lo + n) of `out` from rows [in_lo, in_lo + n) of `inp`, with the
// layer's weights at [w_lo, w_lo + C).
fn k_layernorm_forward<const R : i32, const RI : i32, const C : i32, const RW : i32>(
    out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, mean : &mut Tensor<f32, [R, 1], Memory::GPU_HBM>,
    rstd : &mut Tensor<f32, [R, 1], Memory::GPU_HBM>, inp : &Tensor<f32, [RI, C], Memory::GPU_HBM>,
    weight : &Tensor<f32, [RW, 1], Memory::GPU_HBM>, bias : &Tensor<f32, [RW, 1], Memory::GPU_HBM>,
    in_lo : i32, w_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let x = in_lo + r - lo;
        let mut m : f32 = 0.0;
        for i in 0..C { m = m + inp[x][i]; }
        m = m / (C as f32);
        let mut v : f32 = 0.0;
        for i in 0..C {
          let xshift = inp[x][i] - m;
          v = v + xshift * xshift;
        }
        v = v / (C as f32);
        let s = 1.0 / (v + 0.00001).sqrt();
        for i in 0..C {
          let nrm = s * (inp[x][i] - m);
          out[r][i] = nrm * weight[w_lo + i][0] + bias[w_lo + i][0];
        }
        mean[r][0] = m;
        rstd[r][0] = s;
      }
    }
  }
  return;
}

// out = the attention output, for rows [lo, lo + n) of out: each position
// collects its heads from `scratch`.
fn k_attention_out_gather<const R : i32, const C : i32, const RA : i32, const T : i32>(
    out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, scratch : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
    NH : i32, BT : i32, l : i32, lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / T;
        let t = rr % T;
        for h in 0..NH {
          let a = l * BT * NH + b * NH * T + h * T + t;
          for i in 0..hs { out[r][h * hs + i] = scratch[a][i]; }
        }
      }
    }
  }
  return;
}

// out = a + b, row by row: rows [lo, lo + n) of out, from [a_lo, ..) and [b_lo, ..).
fn k_add<const R : i32, const C : i32, const RA : i32, const RB : i32>(
    out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, a : &Tensor<f32, [RA, C], Memory::GPU_HBM>,
    b : &Tensor<f32, [RB, C], Memory::GPU_HBM>, a_lo : i32, b_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C { out[r][c] = a[a_lo + r - lo][c] + b[b_lo + r - lo][c]; }
      }
    }
  }
  return;
}

// dst += src, row by row: rows [lo, lo + n) of dst, from [src_lo, ..) of src.
fn k_accumulate<const R : i32, const C : i32, const RS : i32>(
    dst : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, src : &Tensor<f32, [RS, C], Memory::GPU_HBM>,
    src_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C { dst[r][c] = dst[r][c] + src[src_lo + r - lo][c]; }
      }
    }
  }
  return;
}

fn k_gelu_forward<const R : i32, const C : i32>(out : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    inp : &Tensor<f32, [R, C], Memory::GPU_HBM>, s : f32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C {
          let x = inp[r][c];
          let cube = 0.044715 * x * x * x;
          out[r][c] = 0.5 * x * (1.0 + (s * (x + cube)).tanh());
        }
      }
    }
  }
  return;
}

// Each row's max and sum of exp(x - max) over its V real columns, for the
// softmax. logits is 32 wide: row r is view rows r * VP / 32 onwards. One thread
// per row, summing in column order as llm.c does.
fn k_softmax_stats<const RW : i32, const BT : i32>(maxes : &mut Tensor<f32, [BT, 1], Memory::GPU_HBM>,
    sums : &mut Tensor<f32, [BT, 1], Memory::GPU_HBM>, logits : &Tensor<f32, [RW, 32], Memory::GPU_HBM>,
    V : i32, VP : i32) -> void {
  let per_row = VP / 32;
  spawn on(Topology::GPU) {
    for r in 0..BT {
      let row0 = r * per_row;
      let mut maxval : f32 = -10000.0;
      for i in 0..V {
        let x = logits[row0 + i / 32][i % 32];
        if x > maxval { maxval = x; }
      }
      let mut sum : f32 = 0.0;
      for i in 0..V {
        sum = sum + (logits[row0 + i / 32][i % 32] - maxval).exp();
      }
      maxes[r][0] = maxval;
      sums[r][0] = sum;
    }
  }
  return;
}

// probs = exp(logits - max) / sum, 32 elements per thread, and 0 in the padded
// columns from V on.
fn k_softmax_forward<const RW : i32, const BT : i32>(probs : &mut Tensor<f32, [RW, 32], Memory::GPU_HBM>,
    logits : &Tensor<f32, [RW, 32], Memory::GPU_HBM>, maxes : &Tensor<f32, [BT, 1], Memory::GPU_HBM>,
    sums : &Tensor<f32, [BT, 1], Memory::GPU_HBM>, V : i32, VP : i32) -> void {
  let per_row = VP / 32;
  spawn on(Topology::GPU) {
    for r in 0..RW {
      let row = r / per_row;
      let c0 = (r % per_row) * 32;
      let maxval = maxes[row][0];
      let sum = sums[row][0];
      for c in 0..32 {
        if c0 + c < V {
          probs[r][c] = (logits[r][c] - maxval).exp() / sum;
        } else {
          probs[r][c] = 0.0;
        }
      }
    }
  }
  return;
}

// losses = -log(probs[target]), with probs 32 wide.
fn k_crossentropy_forward<const BT : i32, const RW : i32>(losses : &mut Tensor<f32, [BT, 1], Memory::GPU_HBM>,
    probs : &Tensor<f32, [RW, 32], Memory::GPU_HBM>, targets : &Tensor<i32, [BT, 1], Memory::GPU_HBM>,
    VP : i32) -> void {
  let per_row = VP / 32;
  spawn on(Topology::GPU) {
    for r in 0..BT {
      let ix = targets[r][0];
      losses[r][0] = 0.0 - probs[r * per_row + ix / 32][ix % 32].ln();
    }
  }
  return;
}

// dlogits += (probs - onehot(target)) * dloss over the V real columns, on the
// 32-wide tensors: view row r is part of row r / (VP / 32), from column
// (r % (VP / 32)) * 32.
fn k_crossentropy_softmax_backward<const RW : i32, const BT : i32>(
    dlogits : &mut Tensor<f32, [RW, 32], Memory::GPU_HBM>, probs : &Tensor<f32, [RW, 32], Memory::GPU_HBM>,
    targets : &Tensor<i32, [BT, 1], Memory::GPU_HBM>, dloss : f32, V : i32, VP : i32) -> void {
  let per_row = VP / 32;
  spawn on(Topology::GPU) {
    for r in 0..RW {
      let ix = targets[r / per_row][0];
      let c0 = (r % per_row) * 32;
      for c in 0..32 {
        let i = c0 + c;
        if i < V {
          let mut indicator : f32 = 0.0;
          if i == ix { indicator = 1.0; }
          dlogits[r][c] = dlogits[r][c] + (probs[r][c] - indicator) * dloss;
        }
      }
    }
  }
  return;
}

// dbias[b_lo + o] += the column sum of dout rows [d_lo, d_lo + BT), one thread per output.
fn k_bias_backward<const RB : i32, const R : i32, const OC : i32>(
    dbias : &mut Tensor<f32, [RB, 1], Memory::GPU_HBM>, dout : &Tensor<f32, [R, OC], Memory::GPU_HBM>,
    b_lo : i32, d_lo : i32, BT : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..RB {
      if r >= b_lo && r < b_lo + OC {
        let o = r - b_lo;
        let mut sum : f32 = 0.0;
        for bt in 0..BT { sum = sum + dout[d_lo + bt][o]; }
        dbias[r][0] = dbias[r][0] + sum;
      }
    }
  }
  return;
}

// k_bias_backward for a 32-wide dout: element (row, o) is at
// [row * (OC / 32) + o / 32][o % 32], the same place in memory.
fn k_bias_backward_wide<const RB : i32, const RW : i32>(
    dbias : &mut Tensor<f32, [RB, 1], Memory::GPU_HBM>, dout : &Tensor<f32, [RW, 32], Memory::GPU_HBM>,
    b_lo : i32, d_lo : i32, BT : i32, OC : i32) -> void {
  let per_row = OC / 32;
  spawn on(Topology::GPU) {
    for r in 0..RB {
      if r >= b_lo && r < b_lo + OC {
        let o = r - b_lo;
        let mut sum : f32 = 0.0;
        for bt in 0..BT { sum = sum + dout[(d_lo + bt) * per_row + o / 32][o % 32]; }
        dbias[r][0] = dbias[r][0] + sum;
      }
    }
  }
  return;
}

// dinp rows [lo, lo + n) from rows [d_lo, ..) of dout, inp, mean and rstd.
fn k_layernorm_backward_inp<const R : i32, const C : i32, const RD : i32, const RI : i32, const RW : i32>(
    dinp : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, dout : &Tensor<f32, [RD, C], Memory::GPU_HBM>,
    inp : &Tensor<f32, [RI, C], Memory::GPU_HBM>, weight : &Tensor<f32, [RW, 1], Memory::GPU_HBM>,
    mean : &Tensor<f32, [RD, 1], Memory::GPU_HBM>, rstd : &Tensor<f32, [RD, 1], Memory::GPU_HBM>,
    d_lo : i32, in_lo : i32, w_lo : i32, lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let d = d_lo + r - lo;
        let x = in_lo + r - lo;
        let mean_bt = mean[d][0];
        let rstd_bt = rstd[d][0];
        let mut dnorm_mean : f32 = 0.0;
        let mut dnorm_norm_mean : f32 = 0.0;
        for i in 0..C {
          let norm_bti = (inp[x][i] - mean_bt) * rstd_bt;
          let dnorm_i = weight[w_lo + i][0] * dout[d][i];
          dnorm_mean = dnorm_mean + dnorm_i;
          dnorm_norm_mean = dnorm_norm_mean + dnorm_i * norm_bti;
        }
        dnorm_mean = dnorm_mean / (C as f32);
        dnorm_norm_mean = dnorm_norm_mean / (C as f32);
        for i in 0..C {
          let norm_bti = (inp[x][i] - mean_bt) * rstd_bt;
          let dnorm_i = weight[w_lo + i][0] * dout[d][i];
          let mut dval : f32 = 0.0;
          dval = dval + dnorm_i;
          dval = dval - dnorm_mean;
          dval = dval - norm_bti * dnorm_norm_mean;
          dval = dval * rstd_bt;
          dinp[r][i] = dinp[r][i] + dval;
        }
      }
    }
  }
  return;
}

// dweight and dbias at [w_lo, w_lo + C): column sums over BT rows from d_lo.
fn k_layernorm_backward_params<const RW : i32, const RD : i32, const C : i32, const RI : i32>(
    dweight : &mut Tensor<f32, [RW, 1], Memory::GPU_HBM>, dbias : &mut Tensor<f32, [RW, 1], Memory::GPU_HBM>,
    dout : &Tensor<f32, [RD, C], Memory::GPU_HBM>, inp : &Tensor<f32, [RI, C], Memory::GPU_HBM>,
    mean : &Tensor<f32, [RD, 1], Memory::GPU_HBM>, rstd : &Tensor<f32, [RD, 1], Memory::GPU_HBM>,
    w_lo : i32, d_lo : i32, in_lo : i32, BT : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..RW {
      if r >= w_lo && r < w_lo + C {
        let i = r - w_lo;
        let mut dw : f32 = dweight[r][0];
        let mut db : f32 = dbias[r][0];
        for bt in 0..BT {
          let norm_bti = (inp[in_lo + bt][i] - mean[d_lo + bt][0]) * rstd[d_lo + bt][0];
          db = db + dout[d_lo + bt][i];
          dw = dw + norm_bti * dout[d_lo + bt][i];
        }
        dweight[r][0] = dw;
        dbias[r][0] = db;
      }
    }
  }
  return;
}

// sech^2 is written as 1 - tanh^2: Vx kernels have tanh but not cosh.
fn k_gelu_backward<const R : i32, const C : i32>(dinp : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    inp : &Tensor<f32, [R, C], Memory::GPU_HBM>, dout : &Tensor<f32, [R, C], Memory::GPU_HBM>, s : f32,
    lo : i32, n : i32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        for c in 0..C {
          let x = inp[r][c];
          let cube = 0.044715 * x * x * x;
          let tanh_out = (s * (x + cube)).tanh();
          let sech_out = 1.0 - tanh_out * tanh_out;
          let local_grad = 0.5 * (1.0 + tanh_out) + x * 0.5 * sech_out * s * (1.0 + 3.0 * 0.044715 * x * x);
          dinp[r][c] = dinp[r][c] + local_grad * dout[r][c];
        }
      }
    }
  }
  return;
}

// dqkv += one part of it from `scratch`, for rows [lo, lo + n) of dqkv: each
// position collects its heads.
fn k_attention_backward_gather<const R : i32, const C3 : i32, const RA : i32, const T : i32, const C : i32>(
    dqkv : &mut Tensor<f32, [R, C3], Memory::GPU_HBM>, scratch : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
    NH : i32, BT : i32, l : i32, part : i32, lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..R {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / T;
        let t = rr % T;
        for h in 0..NH {
          let a = l * BT * NH + b * NH * T + h * T + t;
          for i in 0..hs {
            dqkv[r][part * C + h * hs + i] = dqkv[r][part * C + h * hs + i] + scratch[a][i];
          }
        }
      }
    }
  }
  return;
}

// One thread per vocabulary row gathers that token's positions, so no two
// threads write the same row.
fn k_encoder_backward_wte<const VP : i32, const C : i32, const BT : i32>(
    dwte : &mut Tensor<f32, [VP, C], Memory::GPU_HBM>, dout : &Tensor<f32, [BT, C], Memory::GPU_HBM>,
    inp : &Tensor<i32, [BT, 1], Memory::GPU_HBM>) -> void {
  spawn on(Topology::GPU) {
    for v in 0..VP {
      for bt in 0..BT {
        if inp[bt][0] == v {
          for i in 0..C { dwte[v][i] = dwte[v][i] + dout[bt][i]; }
        }
      }
    }
  }
  return;
}

fn k_encoder_backward_wpe<const MAXT : i32, const C : i32, const BT : i32>(
    dwpe : &mut Tensor<f32, [MAXT, C], Memory::GPU_HBM>, dout : &Tensor<f32, [BT, C], Memory::GPU_HBM>,
    T : i32) -> void {
  spawn on(Topology::GPU) {
    for t in 0..MAXT {
      if t < T {
        for b in 0..(BT / T) {
          for i in 0..C { dwpe[t][i] = dwpe[t][i] + dout[b * T + t][i]; }
        }
      }
    }
  }
  return;
}

fn k_adamw<const R : i32, const C : i32>(params : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    grads : &Tensor<f32, [R, C], Memory::GPU_HBM>, ms : &mut Tensor<f32, [R, C], Memory::GPU_HBM>,
    vs : &mut Tensor<f32, [R, C], Memory::GPU_HBM>, learning_rate : f32, beta1 : f32, beta2 : f32,
    eps : f32, weight_decay : f32, beta1_correction : f32, beta2_correction : f32) -> void {
  spawn on(Topology::GPU) {
    for r in 0..R {
      for c in 0..C {
        let param = params[r][c];
        let g = grads[r][c];
        let m = beta1 * ms[r][c] + (1.0 - beta1) * g;
        let v = beta2 * vs[r][c] + (1.0 - beta2) * g * g;
        let m_hat = m / beta1_correction;
        let v_hat = v / beta2_correction;
        ms[r][c] = m;
        vs[r][c] = v;
        params[r][c] = param - learning_rate * (m_hat / (v_hat.sqrt() + eps) + weight_decay * param);
      }
    }
  }
  return;
}
