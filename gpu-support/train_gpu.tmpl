// GPT-2 training on the GPU. Every buffer a training step touches is a tensor
// placed in `Memory::GPU_HBM`, allocated in `run` so Vx's capacity check sees the
// whole step at once. Compile against a machine file that gives GPU_HBM a GPU's
// capacity, and the compiler answers whether this exact program fits that GPU.
//
// Mode 0 checks one forward and backward pass and ten AdamW steps against a
// reference, as test_gpt2.vx does. Mode 1 trains, as train.vx does. Mode 2 runs
// five training steps only, for memory and speed measurements, and mode 3 does
// the same and also prints where each step's time goes.
//
// Shapes must be compile-time constants that Vx can match by name, so each
// extent is its own generic parameter: C3 = 3C, C4 = 4C, BT = B*T,
// LBT = L*B*T, LC = L*C, LC3 = L*3C, LC4 = L*4C. Tensors that only cuBLAS and
// elementwise kernels write are narrow, the same bytes in the same order, so
// that the threads of a warp read neighbouring elements: preatt, att and their
// gradients are AW wide, RAW = L*B*NH*T*T/AW rows; fch, fch_gelu, logits, probs
// and their gradients are EW wide, LBTC4W = L*B*T*4C/EW and BTVPW = B*T*Vp/EW
// rows. The large weights and their AdamW moments are EW wide too: VPCW = Vp*C/EW,
// MAXTCW = maxT*C/EW, LC3CW = L*3C*C/EW, LCCW = L*C*C/EW, LC4CW = L*4C*C/EW rows.
import data;
import gpu;
import utils;
import std::time;

extern "C" {
  fn fabsf(x : f32) -> f32;
}

// The time now. In mode 3 it waits for the GPU first, so the times between
// calls split a step into phases; in the other modes it does not wait.
fn phase_time(mode : i32) -> f64 {
  if mode == 3 { unsafe { vx_synchronize(); } }
  return unix_timestamp();
}

// Fills `t` from `src` starting at element `off`, and answers the next offset.
fn load<const R : i32, const C : i32>(t : &mut Tensor<f32, [R, C]>, src : *mut f32, off : i64) -> i64 {
  for r in 0..R {
    for c in 0..C {
      unsafe { t[r][c] = src[off + (r as i64) * (C as i64) + (c as i64)]; }
    }
  }
  return off + (R as i64) * (C as i64);
}

// Compares n values of a from a_off with b from b_off. Answers whether every
// difference is within `tol` of b's largest magnitude, and prints the largest
// difference.
fn check_close(a : *mut f32, a_off : i64, b : *mut f32, b_off : i64, n : i64, tol : f32,
               label : *const i8) -> bool {
  let mut maxdiff : f32 = 0.0;
  let mut maxabs : f32 = 0.0;
  unsafe {
    for i in 0..n {
      let diff = fabsf(a[a_off + i] - b[b_off + i]);
      if diff > maxdiff { maxdiff = diff; }
      if fabsf(b[b_off + i]) > maxabs { maxabs = fabsf(b[b_off + i]); }
    }
  }
  let ok = maxdiff <= tol * maxabs;
  print!(label);
  if ok { print!(" OK, maxdiff = "); } else { print!(" NOT OK, maxdiff = "); }
  print(maxdiff); print!(" of "); print(maxabs); print!("\n");
  return ok;
}

fn run<const L : i32, const NH : i32, const C : i32, const C3 : i32, const C4 : i32, const VP : i32,
       const V : i32, const MAXT : i32, const B : i32, const T : i32, const BT : i32, const LBT : i32,
       const RAW : i32, const AW : i32, const LC : i32, const LC3 : i32, const LC4 : i32, const LBTC4W : i32,
       const BTVPW : i32, const EW : i32, const VPCW : i32, const MAXTCW : i32, const LC3CW : i32,
       const LCCW : i32, const LC4CW : i32>(
    mode : i32, model_path : *const i8, state_path : *const i8, losses_path : *const i8,
    train_path : *const i8, val_path : *const i8, tokenizer_path : *const i8) -> i32 {
  let T64 = T as i64;
  let C64 = C as i64;
  let BT64 = BT as i64;
  let consistent = C3 == 3 * C && C4 == 4 * C && BT == B * T && LBT == L * BT && LC == L * C
    && LC3 == L * C3 && LC4 == L * C4 && T % AW == 0 && AW >= 4 && VP % EW == 0 && C % EW == 0 && EW >= 2
    && (RAW as i64) * (AW as i64) == (L as i64) * (B as i64) * (NH as i64) * T64 * T64
    && (LBTC4W as i64) * (EW as i64) == (LBT as i64) * (C4 as i64)
    && (BTVPW as i64) * (EW as i64) == BT64 * (VP as i64) && VPCW * EW == VP * C && MAXTCW * EW == MAXT * C
    && LC3CW * EW == LC3 * C && LCCW * EW == LC * C && LC4CW * EW == LC4 * C;
  if !consistent {
    print!("inconsistent shape parameters\n");
    return 1;
  }
  let mut model_file = unmapped();
  if !map_file(model_path, &mut model_file) {
    print!("cannot open "); print!(model_path); print!("\n");
    return 1;
  }
  let header : *mut i32 = model_file.data;
  let ok_header = unsafe {
    header[0] == 20240326 && header[1] == 3 && header[2] == MAXT && header[3] == V
      && header[4] == L && header[5] == NH && header[6] == C && header[7] == VP
  };
  if !ok_header {
    print!("checkpoint does not match the compiled configuration\n");
    return 1;
  }
  print!("[GPT-2 on "); if mode == 0 { print!("GPU, test]\n"); } else { print!("GPU, train]\n"); }

  // Parameters, read from the checkpoint and moved to the GPU.
  let weights : *mut f32 = model_file.data;
  let mut off : i64 = 256;
@PARAMS@
  // Gradients and AdamW moments, one tensor per parameter tensor.
@GRADS@
@MS@
@VS@
  // Activations and their gradients, in llm.c's layout.
@ACTS@
@GRADACTS@
  let in_h = Tensor<i32, [BT, 1]>::uninit();
  let mut inputs = transfer(in_h, Memory::GPU_HBM);
  let tg_h = Tensor<i32, [BT, 1]>::uninit();
  let mut targets = transfer(tg_h, Memory::GPU_HBM);

@ZERO_INIT@
  // d_losses is in llm.c's layout, but nothing reads it here: it holds the
  // column of ones that bias additions and bias gradients multiply by.
  k_fill<BT, 1>(&mut d_losses, 1.0);
  // cuBLAS reads att and d_preatt whole, and the kernels skip the tensor rows
  // that lie wholly past the diagonal, so those stay the zero written here.
  unsafe {
    vx_zero_f32(att.as_mut_ptr(), (RAW as i64) * (AW as i64));
    vx_zero_f32(d_preatt.as_mut_ptr(), (RAW as i64) * (AW as i64));
  }

  // Host buffers: the next batch, the losses and one row of probabilities.
  let mut host_inputs = Tensor<i32>([BT]);
  let mut host_targets = Tensor<i32>([BT]);
  let mut host_losses = Tensor<f32>([BT]);
  let mut host_probs = Tensor<f32>([VP]);
  let hin : *mut i32 = host_inputs.as_mut_ptr();
  let htg : *mut i32 = host_targets.as_mut_ptr();
  let hloss : *mut f32 = host_losses.as_mut_ptr();
  let hprobs : *mut f32 = host_probs.as_mut_ptr();

  let sqrt_hs = unsafe { sqrtf((C / NH) as f32) };
  let scale = (1.0f64 / (sqrt_hs as f64)) as f32;
  let s = gelu_scale();
  let c4w = C4 / EW;
  // Attention: head size, one layer's (B, NH, T, T) matrix in elements and in
  // tensor rows, and the partial softmax statistics per attention row (up to a
  // warp's 32) and per row of logits.
  let hs = C / NH;
  let hs64 = hs as i64;
  let C3_64 = C3 as i64;
  let TT = T64 * T64;
  let NHTT = (NH as i64) * TT;
  let att_layer = (B as i64) * NHTT;
  let att_rows = B * NH * T * (T / AW);
  let mut P = T / AW;
  if P > 32 { P = 32; }
  let mut PL = 128;
  while VP % PL != 0 || PL > VP / EW { PL = PL / 2; }
  let mut mean_loss : f32 = 0.0;

  // Mode 0: the reference batch, logits, loss, gradients and ten losses.
  let mut state_file = unmapped();
  let mut losses_file = unmapped();
  let mut exact_losses = Tensor<f32>([10]);
  let mut expected_losses : *mut f32 = exact_losses.as_mut_ptr();
  // Mode 1: data, tokenizer and sampler.
  let mut train_rng = Tensor<i64>([624]);
  let mut val_rng = Tensor<i64>([624]);
  let mut train_loader = DataLoader {
    tokens: unsafe { 0 as *mut u16 }, num_tokens: 0, B: 0, T: 0, num_samples: 0, current_sample: 0,
    should_shuffle: false, indices: unsafe { 0 as *mut i32 },
    rng_state: unsafe { 0 as *mut i64 }, rng_left: 1, rng_next: 0,
    inputs: unsafe { 0 as *mut i32 }, targets: unsafe { 0 as *mut i32 }
  };
  let mut val_loader = DataLoader {
    tokens: unsafe { 0 as *mut u16 }, num_tokens: 0, B: 0, T: 0, num_samples: 0, current_sample: 0,
    should_shuffle: false, indices: unsafe { 0 as *mut i32 },
    rng_state: unsafe { 0 as *mut i64 }, rng_left: 1, rng_next: 0,
    inputs: unsafe { 0 as *mut i32 }, targets: unsafe { 0 as *mut i32 }
  };
  let mut tokenizer = Tokenizer {
    bytes: unsafe { 0 as *mut u8 }, offsets: unsafe { 0 as *mut i64 }, vocab_size: 0,
    eot_token: 0, init_ok: false
  };
  let mut rng = Xorshift { s: 1337u64 };
  let mut gen_tokens = Tensor<i32>([BT]);
  let gen : *mut i32 = gen_tokens.as_mut_ptr();

  let mut last_step = 40;
  if mode >= 2 { last_step = 4; }
  if mode == 0 {
    last_step = 9;
    if !map_file(state_path, &mut state_file) || !map_file(losses_path, &mut losses_file) {
      print!("cannot open the reference state\n");
      return 1;
    }
    let state : *mut i32 = state_file.data;
    let ok_state = unsafe { state[0] == 20240327 && state[1] == 2 && state[2] == B && state[3] == T };
    if !ok_state {
      print!("state does not match the compiled configuration\n");
      return 1;
    }
    unsafe {
      for i in 0..BT {
        hin[i] = state[256 + i];
        htg[i] = state[256 + BT + i];
      }
    }
    expected_losses = losses_file.data;
  } else {
    if !dataloader_init(&mut train_loader, train_path, B as i64, T as i64, true,
                        train_rng.as_mut_ptr(), hin, htg) {
      return 1;
    }
    if !dataloader_init(&mut val_loader, val_path, B as i64, T as i64, false,
                        val_rng.as_mut_ptr(), hin, htg) {
      return 1;
    }
    tokenizer_init(&mut tokenizer, tokenizer_path);
  }

  // Each pass of this loop runs one forward pass. Before it, the schedule picks
  // the job: 0 a validation batch, 1 a generated token, 2 a training step.
  let mut allok = true;
  let mut step : i32 = 0;
  let mut step_started = false;
  let mut val_left = 0;
  let mut val_loss : f32 = 0.0;
  let mut gen_t = 0;
  while step <= last_step {
    if !step_started && mode == 1 {
      if step % 10 == 0 {
        val_left = 5;
        val_loss = 0.0;
        dataloader_reset(&mut val_loader);
      }
      if step > 0 && step % 20 == 0 {
        unsafe {
          for i in 0..BT { gen[i] = tokenizer.eot_token; }
        }
        gen_t = 1;
      }
    }
    step_started = true;
    let mut job = 2;
    if val_left > 0 {
      job = 0;
      dataloader_next_batch(&mut val_loader);
    } else if gen_t > 0 {
      job = 1;
      unsafe {
        for i in 0..BT { hin[i] = gen[i]; }
      }
    } else if mode != 0 {
      dataloader_next_batch(&mut train_loader);
    }
    let start = phase_time(mode);
    let mut t_attn_fwd : f64 = 0.0;
    let mut t_attn_bwd : f64 = 0.0;
    let mut t_mm : f64 = 0.0;
    unsafe {
      vx_upload_i32(inputs.as_mut_ptr(), hin, BT as i64);
      vx_upload_i32(targets.as_mut_ptr(), htg, BT as i64);
    }

    // Forward pass.
    k_encoder_forward<BT, C, VPCW, MAXTCW, EW>(&mut encoded, &inputs, &wte, &wpe, T);
    for l in 0..L {
      let lo = l * BT;
      let lo64 = lo as i64;
      let l64 = l as i64;
      if l == 0 {
        k_layernorm_forward<LBT, BT, C, LC>(&mut ln1, &mut ln1_mean, &mut ln1_rstd, &encoded, &ln1w, &ln1b,
                                            0, l * C, lo, BT);
      } else {
        k_layernorm_forward<LBT, LBT, C, LC>(&mut ln1, &mut ln1_mean, &mut ln1_rstd, &residual3, &ln1w, &ln1b,
                                             lo - BT, l * C, lo, BT);
      }
      let m0 = phase_time(mode);
      unsafe {
        cublas_matmul_forward(vx_dev_at(qkv.as_mut_ptr(), lo64 * (C3 as i64)), vx_dev_at(ln1.as_mut_ptr(), lo64 * (C as i64)),
                       vx_dev_at(qkvw.as_mut_ptr(), l64 * (C3 as i64) * (C as i64)), BT, C, C3);
      }
      t_mm = t_mm + phase_time(mode) - m0;
      let m1 = phase_time(mode);
      unsafe {
        cublas_add_bias(vx_dev_at(qkv.as_mut_ptr(), lo64 * (C3 as i64)), vx_dev_at(qkvb.as_mut_ptr(), l64 * (C3 as i64)),
                        d_losses.as_mut_ptr(), BT, C3);
      }
      t_mm = t_mm + phase_time(mode) - m1;
      // Attention, as llm.c's CUDA version does it: preatt = scale * QK^T and
      // atty = att V on cuBLAS, the softmax between them in Vx. d_att is dead
      // until the backward pass, so it holds the softmax's partial statistics.
      let a0 = phase_time(mode);
      let att_l = l64 * att_layer;
      unsafe {
        let qkv_l = vx_dev_at(qkv.as_mut_ptr(), lo64 * C3_64);
        cublas_heads(1, 0, T, T, hs, scale, vx_dev_at(qkv_l, C64), C3, hs64, T64 * C3_64, qkv_l, C3, hs64, T64 * C3_64,
                     vx_dev_at(preatt.as_mut_ptr(), att_l), T, TT, NHTT, NH, B);
      }
      k_att_partials<RAW, AW>(&mut d_att, &preatt, T, P, l * att_rows, B * NH * T * P);
      k_att_row_stats<RAW, AW>(&mut d_att, P, l * att_rows, B * NH * T * P);
      k_att_softmax<RAW, AW>(&mut att, &preatt, &d_att, T, P, l * att_rows, att_rows);
      unsafe {
        cublas_heads(0, 0, hs, T, T, 1.0, vx_dev_at(qkv.as_mut_ptr(), lo64 * C3_64 + 2 * C64), C3, hs64, T64 * C3_64,
                     vx_dev_at(att.as_mut_ptr(), att_l), T, TT, NHTT,
                     vx_dev_at(atty.as_mut_ptr(), lo64 * C64), C, hs64, T64 * C64, NH, B);
      }
      t_attn_fwd = t_attn_fwd + phase_time(mode) - a0;
      let m2 = phase_time(mode);
      unsafe {
        cublas_matmul_forward(vx_dev_at(attproj.as_mut_ptr(), lo64 * (C as i64)), vx_dev_at(atty.as_mut_ptr(), lo64 * (C as i64)),
                       vx_dev_at(attprojw.as_mut_ptr(), l64 * (C as i64) * (C as i64)), BT, C, C);
      }
      t_mm = t_mm + phase_time(mode) - m2;
      let m3 = phase_time(mode);
      unsafe {
        cublas_add_bias(vx_dev_at(attproj.as_mut_ptr(), lo64 * (C as i64)), vx_dev_at(attprojb.as_mut_ptr(), l64 * (C as i64)),
                        d_losses.as_mut_ptr(), BT, C);
      }
      // residual2 = the layer's input + attproj, on cuBLAS.
      if l == 0 {
        unsafe {
          cublas_add(vx_dev_at(residual2.as_mut_ptr(), lo64 * C64), encoded.as_mut_ptr(),
                     vx_dev_at(attproj.as_mut_ptr(), lo64 * C64), BT, C);
        }
      } else {
        unsafe {
          cublas_add(vx_dev_at(residual2.as_mut_ptr(), lo64 * C64), vx_dev_at(residual3.as_mut_ptr(), (lo64 - BT64) * C64),
                     vx_dev_at(attproj.as_mut_ptr(), lo64 * C64), BT, C);
        }
      }
      t_mm = t_mm + phase_time(mode) - m3;
      k_layernorm_forward<LBT, LBT, C, LC>(&mut ln2, &mut ln2_mean, &mut ln2_rstd, &residual2, &ln2w, &ln2b,
                                           lo, l * C, lo, BT);
      let m4 = phase_time(mode);
      unsafe {
        cublas_matmul_forward(vx_dev_at(fch.as_mut_ptr(), lo64 * (C4 as i64)), vx_dev_at(ln2.as_mut_ptr(), lo64 * (C as i64)),
                       vx_dev_at(fcw.as_mut_ptr(), l64 * (C4 as i64) * (C as i64)), BT, C, C4);
      }
      t_mm = t_mm + phase_time(mode) - m4;
      let m5 = phase_time(mode);
      unsafe {
        cublas_add_bias(vx_dev_at(fch.as_mut_ptr(), lo64 * (C4 as i64)), vx_dev_at(fcb.as_mut_ptr(), l64 * (C4 as i64)),
                        d_losses.as_mut_ptr(), BT, C4);
      }
      t_mm = t_mm + phase_time(mode) - m5;
      k_gelu_forward<LBTC4W, EW>(&mut fch_gelu, &fch, s, lo * c4w, BT * c4w);
      let m6 = phase_time(mode);
      unsafe {
        cublas_matmul_forward(vx_dev_at(fcproj.as_mut_ptr(), lo64 * (C as i64)), vx_dev_at(fch_gelu.as_mut_ptr(), lo64 * (C4 as i64)),
                       vx_dev_at(fcprojw.as_mut_ptr(), l64 * (C as i64) * (C4 as i64)), BT, C4, C);
      }
      t_mm = t_mm + phase_time(mode) - m6;
      let m7 = phase_time(mode);
      unsafe {
        cublas_add_bias(vx_dev_at(fcproj.as_mut_ptr(), lo64 * (C as i64)), vx_dev_at(fcprojb.as_mut_ptr(), l64 * (C as i64)),
                        d_losses.as_mut_ptr(), BT, C);
        cublas_add(vx_dev_at(residual3.as_mut_ptr(), lo64 * C64), vx_dev_at(residual2.as_mut_ptr(), lo64 * C64),
                   vx_dev_at(fcproj.as_mut_ptr(), lo64 * C64), BT, C);
      }
      t_mm = t_mm + phase_time(mode) - m7;
    }
    k_layernorm_forward<BT, LBT, C, C>(&mut lnf, &mut lnf_mean, &mut lnf_rstd, &residual3, &lnfw, &lnfb,
                                       (L - 1) * BT, 0, 0, BT);
    let m8 = phase_time(mode);
    unsafe { cublas_matmul_forward(logits.as_mut_ptr(), lnf.as_mut_ptr(), wte.as_mut_ptr(), BT, C, VP); }
    t_mm = t_mm + phase_time(mode) - m8;
    // The softmax over the vocabulary. d_logits is dead until the backward pass,
    // so it holds the partial statistics; d_lnf_mean and d_lnf_rstd are in
    // llm.c's layout, but nothing reads them here, so they hold each row's max
    // and sum. The loss and its gradient need only those, so probs is written
    // only for generation.
    k_logits_partials<BTVPW, EW>(&mut d_logits, &logits, V, VP, PL, BT * PL);
    k_logits_stats<BT, BTVPW, EW>(&mut d_lnf_mean, &mut d_lnf_rstd, &d_logits, PL);
    if job == 1 {
      k_softmax_forward<BTVPW, BT, EW>(&mut probs, &logits, &d_lnf_mean, &d_lnf_rstd, V, VP);
    } else {
      k_crossentropy_forward<BT, BTVPW, EW>(&mut losses, &logits, &d_lnf_mean, &d_lnf_rstd, &targets, VP);
      unsafe { vx_download_f32(hloss, 0, losses.as_mut_ptr(), BT as i64); }
      mean_loss = 0.0;
      unsafe {
        for i in 0..BT { mean_loss = mean_loss + hloss[i]; }
      }
      mean_loss = mean_loss / (BT as f32);
    }

    let t_fwd = phase_time(mode) - start;

    if job == 0 {
      val_loss = val_loss + mean_loss;
      val_left = val_left - 1;
      if val_left == 0 {
        print!("val loss "); print(val_loss / 5.0); print!("\n");
      }
    } else if job == 1 {
      if gen_t == 1 { print!("generating:\n---\n"); }
      unsafe {
        vx_download_f32(hprobs, 0, vx_dev_at(probs.as_mut_ptr(), ((gen_t - 1) as i64) * (VP as i64)), VP as i64);
      }
      let coin = random_f32(&mut rng);
      let next_token = sample_mult(hprobs, V as i64, coin);
      unsafe { gen[gen_t] = next_token; }
      if tokenizer.init_ok {
        tokenizer_print(&tokenizer, next_token);
      } else {
        print(next_token); print!(" ");
      }
      gen_t = gen_t + 1;
      if gen_t == 64 {
        gen_t = 0;
        print!("\n---\n");
      }
    } else {
      // Backward pass.
@ZERO_GRAD@
      let dloss : f32 = 1.0 / (BT as f32);
      let ones = d_losses.as_mut_ptr();
      k_crossentropy_softmax_backward<BTVPW, BT, EW>(&mut d_logits, &logits, &d_lnf_mean, &d_lnf_rstd, &targets, dloss,
                                                      V, VP);
      let m9 = phase_time(mode);
      unsafe {
        cublas_matmul_backward(d_lnf.as_mut_ptr(), d_wte.as_mut_ptr(), d_logits.as_mut_ptr(), lnf.as_mut_ptr(),
                        wte.as_mut_ptr(), BT, C, VP);
      }
      t_mm = t_mm + phase_time(mode) - m9;
      // The residual stream's gradient starts at the last layer's d_residual3.
      k_layernorm_backward_inp<LBT, C, BT, LBT, C>(&mut d_residual3, &d_lnf, &residual3, &lnfw, &lnf_mean, &lnf_rstd,
                                                   0, (L - 1) * BT, 0, (L - 1) * BT, BT);
      k_layernorm_backward_params<C, BT, C, LBT, LBT>(&mut d_lnfw, &mut d_lnfb, &d_lnf, &residual3, &residual3, &lnf_mean,
                                                      &lnf_rstd, false, (L - 1) * BT, BT);
      let mut l = L - 1;
      while l >= 0 {
        let lo = l * BT;
        let lo64 = lo as i64;
        let l64 = l as i64;
        // The MLP's output gradient is the residual stream's, d_residual3: llm.c's
        // CPU code copies it into d_fcproj first, its CUDA code does not.
        let m10 = phase_time(mode);
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_fch_gelu.as_mut_ptr(), lo64 * (C4 as i64)),
                          vx_dev_at(d_fcprojw.as_mut_ptr(), l64 * (C as i64) * (C4 as i64)),
                          vx_dev_at(d_residual3.as_mut_ptr(), lo64 * C64),
                          vx_dev_at(fch_gelu.as_mut_ptr(), lo64 * (C4 as i64)),
                          vx_dev_at(fcprojw.as_mut_ptr(), l64 * (C as i64) * (C4 as i64)), BT, C4, C);
          cublas_bias_backward(vx_dev_at(d_fcprojb.as_mut_ptr(), l64 * C64), vx_dev_at(d_residual3.as_mut_ptr(), lo64 * C64),
                               ones, BT, C);
        }
        t_mm = t_mm + phase_time(mode) - m10;
        k_gelu_backward<LBTC4W, EW>(&mut d_fch, &fch, &d_fch_gelu, s, lo * c4w, BT * c4w);
        let m11 = phase_time(mode);
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_ln2.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(d_fcw.as_mut_ptr(), l64 * (C4 as i64) * (C as i64)),
                          vx_dev_at(d_fch.as_mut_ptr(), lo64 * (C4 as i64)),
                          vx_dev_at(ln2.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(fcw.as_mut_ptr(), l64 * (C4 as i64) * (C as i64)), BT, C, C4);
          cublas_bias_backward(vx_dev_at(d_fcb.as_mut_ptr(), l64 * (C4 as i64)), vx_dev_at(d_fch.as_mut_ptr(), lo64 * (C4 as i64)),
                               ones, BT, C4);
        }
        t_mm = t_mm + phase_time(mode) - m11;
        // d_residual2 = the second layernorm's input gradient + d_residual3.
        k_layernorm_backward_inp<LBT, C, LBT, LBT, LC>(&mut d_residual2, &d_ln2, &residual2, &ln2w, &ln2_mean, &ln2_rstd,
                                                       lo, lo, l * C, lo, BT);
        unsafe {
          cublas_add(vx_dev_at(d_residual2.as_mut_ptr(), lo64 * C64), vx_dev_at(d_residual2.as_mut_ptr(), lo64 * C64),
                     vx_dev_at(d_residual3.as_mut_ptr(), lo64 * C64), BT, C);
        }
        let m12 = phase_time(mode);
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_atty.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(d_attprojw.as_mut_ptr(), l64 * (C as i64) * (C as i64)),
                          vx_dev_at(d_residual2.as_mut_ptr(), lo64 * C64),
                          vx_dev_at(atty.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(attprojw.as_mut_ptr(), l64 * (C as i64) * (C as i64)), BT, C, C);
          cublas_bias_backward(vx_dev_at(d_attprojb.as_mut_ptr(), l64 * C64), vx_dev_at(d_residual2.as_mut_ptr(), lo64 * C64),
                               ones, BT, C);
        }
        t_mm = t_mm + phase_time(mode) - m12;
        // Attention backward, as llm.c's CUDA version does it: datt = dout V^T and
        // dv = att^T dout, the softmax backward in Vx, then dq = dpreatt K and
        // dk = dpreatt^T Q. preatt is dead now, so it holds each row's dot.
        let a0 = phase_time(mode);
        let att_l = l64 * att_layer;
        let qkv_l = lo64 * C3_64;
        unsafe {
          cublas_heads(1, 0, T, T, hs, 1.0, vx_dev_at(qkv.as_mut_ptr(), qkv_l + 2 * C64), C3, hs64, T64 * C3_64,
                       vx_dev_at(d_atty.as_mut_ptr(), lo64 * C64), C, hs64, T64 * C64,
                       vx_dev_at(d_att.as_mut_ptr(), att_l), T, TT, NHTT, NH, B);
          cublas_heads(0, 1, hs, T, T, 1.0, vx_dev_at(d_atty.as_mut_ptr(), lo64 * C64), C, hs64, T64 * C64,
                       vx_dev_at(att.as_mut_ptr(), att_l), T, TT, NHTT,
                       vx_dev_at(d_qkv.as_mut_ptr(), qkv_l + 2 * C64), C3, hs64, T64 * C3_64, NH, B);
        }
        k_att_dots<RAW, AW, LBT, C>(&mut preatt, &d_atty, &atty, NH, T, lo, l * att_rows, B * NH * T);
        k_att_softmax_backward<RAW, AW>(&mut d_preatt, &att, &d_att, &preatt, T, scale, l * att_rows, att_rows);
        unsafe {
          cublas_heads(0, 0, hs, T, T, 1.0, vx_dev_at(qkv.as_mut_ptr(), qkv_l + C64), C3, hs64, T64 * C3_64,
                       vx_dev_at(d_preatt.as_mut_ptr(), att_l), T, TT, NHTT,
                       vx_dev_at(d_qkv.as_mut_ptr(), qkv_l), C3, hs64, T64 * C3_64, NH, B);
          cublas_heads(0, 1, hs, T, T, 1.0, vx_dev_at(qkv.as_mut_ptr(), qkv_l), C3, hs64, T64 * C3_64,
                       vx_dev_at(d_preatt.as_mut_ptr(), att_l), T, TT, NHTT,
                       vx_dev_at(d_qkv.as_mut_ptr(), qkv_l + C64), C3, hs64, T64 * C3_64, NH, B);
        }
        t_attn_bwd = t_attn_bwd + phase_time(mode) - a0;
        let m13 = phase_time(mode);
        unsafe {
          cublas_matmul_backward(vx_dev_at(d_ln1.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(d_qkvw.as_mut_ptr(), l64 * (C3 as i64) * (C as i64)),
                          vx_dev_at(d_qkv.as_mut_ptr(), lo64 * (C3 as i64)),
                          vx_dev_at(ln1.as_mut_ptr(), lo64 * (C as i64)),
                          vx_dev_at(qkvw.as_mut_ptr(), l64 * (C3 as i64) * (C as i64)), BT, C, C3);
          cublas_bias_backward(vx_dev_at(d_qkvb.as_mut_ptr(), l64 * C3_64), vx_dev_at(d_qkv.as_mut_ptr(), lo64 * C3_64),
                               ones, BT, C3);
        }
        t_mm = t_mm + phase_time(mode) - m13;
        // The layer's input gradient = d_residual2 + the first layernorm's input
        // gradient: d_encoded for the first layer, else the layer before's d_residual3.
        if l == 0 {
          k_layernorm_backward_inp<BT, C, LBT, BT, LC>(&mut d_encoded, &d_ln1, &encoded, &ln1w, &ln1_mean, &ln1_rstd,
                                                       lo, 0, l * C, 0, BT);
          unsafe {
            cublas_add(d_encoded.as_mut_ptr(), d_encoded.as_mut_ptr(), vx_dev_at(d_residual2.as_mut_ptr(), lo64 * C64),
                       BT, C);
          }
        } else {
          k_layernorm_backward_inp<LBT, C, LBT, LBT, LC>(&mut d_residual3, &d_ln1, &residual3, &ln1w, &ln1_mean,
                                                         &ln1_rstd, lo, lo - BT, l * C, lo - BT, BT);
          unsafe {
            cublas_add(vx_dev_at(d_residual3.as_mut_ptr(), (lo64 - BT64) * C64),
                       vx_dev_at(d_residual3.as_mut_ptr(), (lo64 - BT64) * C64),
                       vx_dev_at(d_residual2.as_mut_ptr(), lo64 * C64), BT, C);
          }
        }
        l = l - 1;
      }
      // The layernorms' weight and bias gradients, every layer in one launch each.
      k_layernorm_backward_params<LC, LBT, C, BT, LBT>(&mut d_ln1w, &mut d_ln1b, &d_ln1, &encoded, &residual3, &ln1_mean,
                                                       &ln1_rstd, true, 0 - BT, BT);
      k_layernorm_backward_params<LC, LBT, C, LBT, LBT>(&mut d_ln2w, &mut d_ln2b, &d_ln2, &residual2, &residual2, &ln2_mean,
                                                        &ln2_rstd, false, 0, BT);
      k_encoder_backward_wte<VP, C, BT>(&mut d_wte, &d_encoded, &inputs);
      k_encoder_backward_wpe<MAXT, C, BT>(&mut d_wpe, &d_encoded, T);
      let t_bwd = phase_time(mode) - start - t_fwd;

      if mode == 0 && step == 0 {
        // Logits, loss and every gradient against the reference.
        let V64 = V as i64;
        let VP64 = VP as i64;
        let expected : *mut f32 = state_file.data;
        let logits_base = 256 + 2 * BT64;
        let expected_loss = unsafe { expected[256 + 2 * BT64 + BT64 * V64] };
        let grads_base = 256 + 2 * BT64 + BT64 * V64 + 1;
        let mut logits_h = Tensor<f32>([BT * VP]);
        let lh : *mut f32 = logits_h.as_mut_ptr();
        unsafe { vx_download_f32(lh, 0, logits.as_mut_ptr(), BT64 * VP64); }
        let mut lmax : f32 = 0.0;
        unsafe {
          for bt in 0..BT64 {
            for vi in 0..V64 {
              let diff = fabsf(expected[logits_base + bt * V64 + vi] - lh[bt * VP64 + vi]);
              if diff > lmax { lmax = diff; }
            }
          }
        }
        let logits_ok = lmax <= 0.0001;
        if logits_ok { print!("OK (LOGITS), max_diff = "); } else { print!("NOT OK (LOGITS), max_diff = "); }
        print(lmax); print!("\n");
        allok = allok && logits_ok;
        let loss_ok = unsafe { fabsf(mean_loss - expected_loss) } <= 0.0001;
        if loss_ok { print!("LOSS OK: "); } else { print!("LOSS MISMATCH: "); }
        print(mean_loss); print!(" "); print(expected_loss); print!("\n");
        allok = allok && loss_ok;

        let mut grads_h = Tensor<f32>([VP * C + MAXT * C + L * (12 * C * C + 13 * C) + 2 * C]);
        let host_grads : *mut f32 = grads_h.as_mut_ptr();
        let mut goff : i64 = 0;
        let tol : f32 = 0.001;
@DOWNLOAD_GRADS@
      }

      // AdamW. The test uses weight decay as test_gpt2.c does; training does not.
      let mut wd : f32 = 0.0;
      if mode == 0 { wd = 0.01; }
      let lr : f32 = 0.0001;
      let beta1_t = unsafe { powf(0.9, (step + 1) as f32) };
      let beta2_t = unsafe { powf(0.999, (step + 1) as f32) };
      let c1 = 1.0 - beta1_t;
      let c2 = 1.0 - beta2_t;
@ADAMW@
      unsafe { vx_synchronize(); }
      let elapsed_ms = (unix_timestamp() - start) * 1000.0;

      if mode == 0 {
        let expected_step_loss = unsafe { expected_losses[step] };
        let step_ok = unsafe { fabsf(expected_step_loss - mean_loss) } <= 0.0001;
        allok = allok && step_ok;
        print!("step "); print(step); print!(": loss "); print(mean_loss);
        print!(" (took "); print(elapsed_ms); print!(" ms) OK = ");
        if step_ok { print!("1\n"); } else { print!("0\n"); }
      } else {
        print!("step "); print(step); print!(": train loss "); print(mean_loss);
        print!(" (took "); print(elapsed_ms); print!(" ms)\n");
        if mode == 3 {
          print!("  forward "); print(t_fwd * 1000.0); print!(" ms, attention "); print(t_attn_fwd * 1000.0);
          print!(" ms; backward "); print(t_bwd * 1000.0); print!(" ms, attention "); print(t_attn_bwd * 1000.0);
          print!(" ms; cuBLAS in both "); print(t_mm * 1000.0); print!(" ms\n");
        }
      }
      step = step + 1;
      step_started = false;
    }
  }

  if mode == 0 {
    if allok {
      print!("overall okay: 1\n");
      return 0;
    }
    print!("overall okay: 0\n");
    return 1;
  }
  return 0;
}
