// The training loop, data loader, tokenizer and sampler from llm.c's
// train_gpt2.c and llmc/{dataloader,rand,tokenizer}.h. The data loader reads
// one shard and shuffles it with llm.c's Mersenne Twister, so batches arrive in
// the same order as in llm.c.
import gpt2;
import utils;
import std::io;
import std::time;

extern "C" {
  // C's calloc. std::alloc's malloc clashes with the allocator tensors use.
  fn calloc(count : i64, size : i64) -> *mut i8;
}

// ----------------------------------------------------------------------------
// Mersenne Twister, numerically identical to torch (llmc/rand.h). Each u32 is
// held in an i64, so the arithmetic cannot overflow.

struct Mt19937 {
  state : *mut i64, // 624 words
  left : i64,
  next : i64,
}

fn manual_seed(rng : &mut Mt19937, seed : i64) -> void {
  let s = rng.state;
  unsafe {
    s[0] = seed & 4294967295;
    for j in 1..624 {
      s[j] = (1812433253 * (s[j - 1] ^ (s[j - 1] >> 30)) + (j as i64)) & 4294967295;
    }
  }
  rng.left = 1;
  rng.next = 0;
}

fn mt_matrix_a(y : i64) -> i64 {
  if (y & 1) == 1 { return 2567483615; }
  return 0;
}

fn next_state(rng : &mut Mt19937) -> void {
  let s = rng.state;
  rng.left = 624;
  rng.next = 0;
  unsafe {
    for j in 0..227 {
      let y = (s[j] & 2147483648) | (s[j + 1] & 2147483647);
      s[j] = s[j + 397] ^ (y >> 1) ^ mt_matrix_a(y);
    }
    for j in 227..623 {
      let y = (s[j] & 2147483648) | (s[j + 1] & 2147483647);
      s[j] = s[j - 227] ^ (y >> 1) ^ mt_matrix_a(y);
    }
    let y = (s[623] & 2147483648) | (s[0] & 2147483647);
    s[623] = s[396] ^ (y >> 1) ^ mt_matrix_a(y);
  }
}

fn randint32(rng : &mut Mt19937) -> i64 {
  rng.left = rng.left - 1;
  if rng.left <= 0 { next_state(rng); }
  let mut y = unsafe { rng.state[rng.next] };
  rng.next = rng.next + 1;
  y = y ^ (y >> 11);
  y = y ^ ((y << 7) & 2636928640);
  y = y ^ ((y << 15) & 4022730752);
  y = y ^ (y >> 18);
  return y & 4294967295;
}

fn random_permutation(data : *mut i32, numel : i64, rng : &mut Mt19937) -> void {
  let mut i = numel - 1;
  while i > 0 {
    let j = randint32(rng) % (i + 1);
    unsafe {
      let tmp = data[i];
      data[i] = data[j];
      data[j] = tmp;
    }
    i = i - 1;
  }
}

// ----------------------------------------------------------------------------
// Data loader for one token shard: a 1 KiB header, then u16 tokens.

struct DataLoader {
  tokens : *mut u16,
  num_tokens : i64,
  B : i64,
  T : i64,
  num_samples : i64,
  current_sample : i64,
  should_shuffle : bool,
  indices : *mut i32,
  rng : Mt19937,
  inputs : *mut i32,
  targets : *mut i32,
}

// Prepares a loader that writes each batch into `inputs` and `targets`.
// `rng_state` holds 624 words. Answers false when the shard is missing or bad.
fn dataloader_init(loader : &mut DataLoader, path : *const i8, B : i64, T : i64, should_shuffle : bool,
                   rng_state : *mut i64, inputs : *mut i32, targets : *mut i32) -> bool {
  let mut file = unmapped();
  if !map_file(path, &mut file) {
    print!("cannot open "); print!(path); print!("\n");
    return false;
  }
  let header : *mut i32 = file.data;
  let ok = unsafe { header[0] == 20240520 && header[1] == 1 };
  if !ok {
    print!("bad magic or version in "); print!(path); print!("\n");
    return false;
  }
  let ntok = unsafe { header[2] as i64 };
  if file.size != 1024 + ntok * 2 {
    print!("unexpected file size for "); print!(path); print!("\n");
    return false;
  }
  loader.tokens = file.data;
  loader.num_tokens = ntok;
  loader.B = B;
  loader.T = T;
  // One token less: each sample reads B*T+1 tokens but advances by B*T.
  loader.num_samples = (ntok * 2 - 2) / (B * T * 2);
  loader.should_shuffle = should_shuffle;
  loader.inputs = inputs;
  loader.targets = targets;
  loader.rng = Mt19937 { state: rng_state, left: 1, next: 0 };
  if should_shuffle {
    manual_seed(&mut loader.rng, 42);
    loader.indices = unsafe { calloc(loader.num_samples, 4) };
  }
  dataloader_reset(loader);
  return true;
}

fn dataloader_reset(loader : &mut DataLoader) -> void {
  loader.current_sample = 0;
  if loader.should_shuffle {
    // llm.c also permutes the shard list here, which draws nothing for one shard.
    let indices = loader.indices;
    unsafe {
      for i in 0..loader.num_samples { indices[i] = i as i32; }
    }
    random_permutation(indices, loader.num_samples, &mut loader.rng);
  }
}

fn dataloader_next_batch(loader : &mut DataLoader) -> void {
  if loader.current_sample >= loader.num_samples {
    dataloader_reset(loader);
  }
  let mut idx = loader.current_sample;
  if loader.should_shuffle {
    idx = unsafe { loader.indices[loader.current_sample] as i64 };
  }
  let BT = loader.B * loader.T;
  // Tokens start after the 512 u16 words of the header.
  let start = 512 + idx * BT;
  let tokens = loader.tokens;
  let inputs = loader.inputs;
  let targets = loader.targets;
  unsafe {
    for i in 0..BT {
      inputs[i] = tokens[start + i] as i32;
      targets[i] = tokens[start + i + 1] as i32;
    }
  }
  loader.current_sample = loader.current_sample + 1;
}

// ----------------------------------------------------------------------------
// GPT-2 tokenizer, decoding only: a 1 KiB header, then a length byte and the
// bytes of each token.

struct Tokenizer {
  bytes : *mut u8,
  offsets : *mut i64,
  vocab_size : i64,
  eot_token : i32,
  init_ok : bool,
}

fn tokenizer_init(tok : &mut Tokenizer, path : *const i8) -> void {
  let mut file = unmapped();
  tok.init_ok = false;
  if !map_file(path, &mut file) {
    print!("---\nWARNING: Failed to open the tokenizer file "); print!(path); print!("\n---\n");
    return;
  }
  let header : *mut i32 = file.data;
  let version = unsafe { header[1] };
  tok.vocab_size = unsafe { header[2] as i64 };
  if version == 1 {
    tok.eot_token = 50256;
  } else {
    tok.eot_token = unsafe { header[3] };
  }
  tok.bytes = file.data;
  tok.offsets = unsafe { calloc(tok.vocab_size, 8) };
  let offsets = tok.offsets;
  let bytes = tok.bytes;
  let mut pos : i64 = 1024;
  unsafe {
    for i in 0..tok.vocab_size {
      offsets[i] = pos;
      pos = pos + 1 + (bytes[pos] as i64);
    }
  }
  tok.init_ok = true;
}

// Prints a token, skipping single bytes that are neither printable nor space,
// as llm.c's safe_printf does.
fn tokenizer_print(tok : &Tokenizer, token : i32) -> void {
  let bytes = tok.bytes;
  let off = unsafe { tok.offsets[token as i64] };
  let len = unsafe { bytes[off] as i64 };
  let first = unsafe { bytes[off + 1] as i64 };
  if first == 0 { return; }
  if len == 1 {
    let printable = first >= 32 && first <= 126;
    let space = first == 32 || (first >= 9 && first <= 13);
    if !printable && !space { return; }
  }
  // printf("%s") stops at the first zero byte.
  let mut n : i64 = 0;
  while n < len && unsafe { bytes[off + 1 + n] as i64 } != 0 { n = n + 1; }
  let start = unsafe { (&mut bytes[off + 1]) as *mut u8 };
  unsafe { stdout_write(start, n as u64); }
}

// ----------------------------------------------------------------------------
// Sampler.

struct Xorshift {
  s : u64,
}

fn random_u32(rng : &mut Xorshift) -> u32 {
  let mut s = rng.s;
  s = s ^ (s >> 12u64);
  s = s ^ (s << 25u64);
  s = s ^ (s >> 27u64);
  rng.s = s;
  return ((s * 2685821657736338717u64) >> 32u64) as u32;
}

// A float in [0, 1).
fn random_f32(rng : &mut Xorshift) -> f32 {
  return ((random_u32(rng) >> 8u32) as f32) / 16777216.0;
}

// Samples an index from probabilities that sum to 1. `coin` is in [0, 1).
fn sample_mult(probabilities : *mut f32, n : i64, coin : f32) -> i32 {
  let mut cdf : f32 = 0.0;
  for i in 0..n {
    cdf = cdf + unsafe { probabilities[i] };
    if coin < cdf { return i as i32; }
  }
  return (n - 1) as i32;
}

// ----------------------------------------------------------------------------
// Training, as llm.c's main: 40 steps of AdamW at B=4, T=64, the validation
// loss every 10 steps and 64 sampled tokens every 20.

fn train<const MAXT : i32, const V : i32, const VP : i32, const L : i32, const NH : i32,
         const C : i32, const B : i32, const T : i32>(model_path : *const i8, train_path : *const i8,
         val_path : *const i8, tokenizer_path : *const i8) -> i32 {
  let config = GPT2Config {
    max_seq_len: MAXT as i64, vocab_size: V as i64, padded_vocab_size: VP as i64,
    num_layers: L as i64, num_heads: NH as i64, channels: C as i64
  };
  let mut model_file = unmapped();
  if !map_file(model_path, &mut model_file) {
    print!("cannot open "); print!(model_path); print!("\n");
    return 1;
  }
  let header : *mut i32 = model_file.data;
  let ok_header = unsafe {
    header[0] == 20240326 && header[1] == 3 && header[2] == MAXT && header[3] == V
      && header[4] == L && header[5] == NH && header[6] == C && header[7] == VP
  };
  if !ok_header {
    print!("checkpoint does not match the compiled configuration\n");
    return 1;
  }

  // Everything a training step touches, allocated in one place so Vx's
  // capacity check sees it together.
  let mut params = Tensor<f32>([VP * C + MAXT * C + L * (12 * C * C + 13 * C) + 2 * C]);
  let mut grads = Tensor<f32>([VP * C + MAXT * C + L * (12 * C * C + 13 * C) + 2 * C]);
  let mut m = Tensor<f32>([VP * C + MAXT * C + L * (12 * C * C + 13 * C) + 2 * C]);
  let mut v = Tensor<f32>([VP * C + MAXT * C + L * (12 * C * C + 13 * C) + 2 * C]);
  let mut acts = Tensor<f32>([B, 2 * T * C + 3 * T + 2 * T * VP + L * (18 * T * C + 4 * T + 2 * NH * T * T)]);
  let mut grads_acts = Tensor<f32>([B, 2 * T * C + 3 * T + 2 * T * VP + L * (18 * T * C + 4 * T + 2 * NH * T * T)]);
  let mut inputs = Tensor<i32>([B * T]);
  let mut targets = Tensor<i32>([B * T]);
  let mut train_rng = Tensor<i64>([624]);
  let mut val_rng = Tensor<i64>([624]);

  let num_params = num_parameters(&config);
  let num_acts = num_activations(&config, B as i64, T as i64);
  let params_memory = params.as_mut_ptr();
  let grads_memory = grads.as_mut_ptr();
  let m_memory = m.as_mut_ptr();
  let v_memory = v.as_mut_ptr();
  let acts_memory = acts.as_mut_ptr();
  let grads_acts_memory = grads_acts.as_mut_ptr();
  let inputs_memory = inputs.as_mut_ptr();
  let targets_memory = targets.as_mut_ptr();

  print!("[GPT-2]\nmax_seq_len: "); print(MAXT); print!("\nvocab_size: "); print(V);
  print!("\npadded_vocab_size: "); print(VP); print!("\nnum_layers: "); print(L);
  print!("\nnum_heads: "); print(NH); print!("\nchannels: "); print(C);
  print!("\nnum_parameters: "); print(num_params); print!("\n");

  let weights : *mut f32 = model_file.data;
  unsafe {
    for i in 0..num_params { params_memory[i] = weights[256 + i]; }
  }
  zero(m_memory, num_params);
  zero(v_memory, num_params);

  let param_ptrs = point_parameters(params_memory, &config);
  let grad_ptrs = point_parameters(grads_memory, &config);
  let act_ptrs = point_activations(acts_memory, &config, B as i64, T as i64);
  let grad_act_ptrs = point_activations(grads_acts_memory, &config, B as i64, T as i64);
  let mut model = GPT2 {
    config: config,
    params: param_ptrs,
    grads: grad_ptrs,
    params_memory: params_memory,
    grads_memory: grads_memory,
    m_memory: m_memory,
    v_memory: v_memory,
    num_parameters: num_params,
    acts: act_ptrs,
    grads_acts: grad_act_ptrs,
    grads_acts_memory: grads_acts_memory,
    num_activations: num_acts,
    batch_size: B as i64,
    seq_len: T as i64,
    inputs: inputs_memory,
    targets: targets_memory,
    mean_loss: -1.0,
  };

  // Both loaders write straight into the model's input and target buffers.
  let mut train_loader = DataLoader {
    tokens: unsafe { 0 as *mut u16 }, num_tokens: 0, B: 0, T: 0, num_samples: 0, current_sample: 0,
    should_shuffle: false, indices: unsafe { 0 as *mut i32 },
    rng: Mt19937 { state: unsafe { 0 as *mut i64 }, left: 1, next: 0 },
    inputs: unsafe { 0 as *mut i32 }, targets: unsafe { 0 as *mut i32 }
  };
  let mut val_loader = DataLoader {
    tokens: unsafe { 0 as *mut u16 }, num_tokens: 0, B: 0, T: 0, num_samples: 0, current_sample: 0,
    should_shuffle: false, indices: unsafe { 0 as *mut i32 },
    rng: Mt19937 { state: unsafe { 0 as *mut i64 }, left: 1, next: 0 },
    inputs: unsafe { 0 as *mut i32 }, targets: unsafe { 0 as *mut i32 }
  };
  if !dataloader_init(&mut train_loader, train_path, B as i64, T as i64, true,
                      train_rng.as_mut_ptr(), inputs_memory, targets_memory) {
    return 1;
  }
  if !dataloader_init(&mut val_loader, val_path, B as i64, T as i64, false,
                      val_rng.as_mut_ptr(), inputs_memory, targets_memory) {
    return 1;
  }
  let BT = (B * T) as i64;
  print!("train dataset num_batches: "); print(train_loader.num_tokens / BT);
  print!("\nval dataset num_batches: "); print(val_loader.num_tokens / BT);
  print!("\nnum_activations: "); print(num_acts); print!("\n");
  let val_num_batches = 5;

  let mut tokenizer = Tokenizer {
    bytes: unsafe { 0 as *mut u8 }, offsets: unsafe { 0 as *mut i64 }, vocab_size: 0,
    eot_token: 0, init_ok: false
  };
  tokenizer_init(&mut tokenizer, tokenizer_path);

  let mut rng = Xorshift { s: 1337u64 };
  let gen_t = 64;

  let mut step : i32 = 0;
  while step <= 40 {
    if step % 10 == 0 {
      let mut val_loss : f32 = 0.0;
      dataloader_reset(&mut val_loader);
      for i in 0..val_num_batches {
        dataloader_next_batch(&mut val_loader);
        gpt2_forward(&mut model, true);
        val_loss = val_loss + model.mean_loss;
      }
      val_loss = val_loss / (val_num_batches as f32);
      print!("val loss "); print(val_loss); print!("\n");
    }

    if step > 0 && step % 20 == 0 {
      // Start every row with the end-of-text token, then sample row 0.
      unsafe {
        for i in 0..BT { inputs_memory[i] = tokenizer.eot_token; }
      }
      print!("generating:\n---\n");
      for t in 1..gen_t {
        gpt2_forward(&mut model, false);
        let probs = at(model.acts.probs, ((t - 1) as i64) * (VP as i64));
        let coin = random_f32(&mut rng);
        let next_token = sample_mult(probs, V as i64, coin);
        unsafe { inputs_memory[t] = next_token; }
        if tokenizer.init_ok {
          tokenizer_print(&tokenizer, next_token);
        } else {
          print(next_token); print!(" ");
        }
      }
      print!("\n---\n");
    }

    let start = unix_timestamp();
    dataloader_next_batch(&mut train_loader);
    gpt2_forward(&mut model, true);
    gpt2_zero_grad(&model);
    gpt2_backward(&model);
    gpt2_update(&model, 0.0001, 0.9, 0.999, 0.00000001, 0.0, step + 1);
    let elapsed_ms = (unix_timestamp() - start) * 1000.0;
    print!("step "); print(step); print!(": train loss "); print(model.mean_loss);
    print!(" (took "); print(elapsed_ms); print!(" ms)\n");
    step = step + 1;
  }

  // Read every buffer after the loop, so the capacity check holds them all
  // resident together, as the training step does.
  let _keep = unsafe {
    params_memory[0] + grads_memory[0] + m_memory[0] + v_memory[0] + acts_memory[0]
      + grads_acts_memory[0] + (inputs_memory[0] as f32) + (targets_memory[0] as f32)
  };
  return 0;
}
