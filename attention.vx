// Generated by gpu-support/gen_attention.py; edit that instead.
//
// The attention kernels of the GPU program, with the values each thread reuses
// across a row of att held in registers: 64 of them for a head size of 64, else
// 16 per pass for any head size that is a multiple of 16. Vx has no local
// arrays, so the 64 are 64 named variables. Every sum runs in llm.c's order.

// Attention scores for one (batch, head, position): q . k for each key at or
// before it, scaled, then the softmax over them. One thread per row of att.
// The query's components stay in registers, so the row of keys is the only
// thing read per key. Nothing reads att above the diagonal, so it is not
// written. hs must be 64 or a multiple of 16.
fn k_attention_scores<const RA : i32, const T : i32, const R : i32, const C3 : i32>(
    preatt : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, att : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>,
    qkv : &Tensor<f32, [R, C3], Memory::GPU_HBM>, NH : i32, BT : i32, l : i32, scale : f32,
    lo : i32, n : i32) -> void {
  let C = C3 / 3;
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..RA {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / (NH * T);
        let h = (rr / T) % NH;
        let t = rr % T;
        let qrow = l * BT + b * T + t;
        let row0 = l * BT + b * T;
        let c0 = h * hs;
        let mut maxval : f32 = -10000.0;
        if hs == 64 {
          let q0 = qkv[qrow][c0];
          let q1 = qkv[qrow][c0 + 1];
          let q2 = qkv[qrow][c0 + 2];
          let q3 = qkv[qrow][c0 + 3];
          let q4 = qkv[qrow][c0 + 4];
          let q5 = qkv[qrow][c0 + 5];
          let q6 = qkv[qrow][c0 + 6];
          let q7 = qkv[qrow][c0 + 7];
          let q8 = qkv[qrow][c0 + 8];
          let q9 = qkv[qrow][c0 + 9];
          let q10 = qkv[qrow][c0 + 10];
          let q11 = qkv[qrow][c0 + 11];
          let q12 = qkv[qrow][c0 + 12];
          let q13 = qkv[qrow][c0 + 13];
          let q14 = qkv[qrow][c0 + 14];
          let q15 = qkv[qrow][c0 + 15];
          let q16 = qkv[qrow][c0 + 16];
          let q17 = qkv[qrow][c0 + 17];
          let q18 = qkv[qrow][c0 + 18];
          let q19 = qkv[qrow][c0 + 19];
          let q20 = qkv[qrow][c0 + 20];
          let q21 = qkv[qrow][c0 + 21];
          let q22 = qkv[qrow][c0 + 22];
          let q23 = qkv[qrow][c0 + 23];
          let q24 = qkv[qrow][c0 + 24];
          let q25 = qkv[qrow][c0 + 25];
          let q26 = qkv[qrow][c0 + 26];
          let q27 = qkv[qrow][c0 + 27];
          let q28 = qkv[qrow][c0 + 28];
          let q29 = qkv[qrow][c0 + 29];
          let q30 = qkv[qrow][c0 + 30];
          let q31 = qkv[qrow][c0 + 31];
          let q32 = qkv[qrow][c0 + 32];
          let q33 = qkv[qrow][c0 + 33];
          let q34 = qkv[qrow][c0 + 34];
          let q35 = qkv[qrow][c0 + 35];
          let q36 = qkv[qrow][c0 + 36];
          let q37 = qkv[qrow][c0 + 37];
          let q38 = qkv[qrow][c0 + 38];
          let q39 = qkv[qrow][c0 + 39];
          let q40 = qkv[qrow][c0 + 40];
          let q41 = qkv[qrow][c0 + 41];
          let q42 = qkv[qrow][c0 + 42];
          let q43 = qkv[qrow][c0 + 43];
          let q44 = qkv[qrow][c0 + 44];
          let q45 = qkv[qrow][c0 + 45];
          let q46 = qkv[qrow][c0 + 46];
          let q47 = qkv[qrow][c0 + 47];
          let q48 = qkv[qrow][c0 + 48];
          let q49 = qkv[qrow][c0 + 49];
          let q50 = qkv[qrow][c0 + 50];
          let q51 = qkv[qrow][c0 + 51];
          let q52 = qkv[qrow][c0 + 52];
          let q53 = qkv[qrow][c0 + 53];
          let q54 = qkv[qrow][c0 + 54];
          let q55 = qkv[qrow][c0 + 55];
          let q56 = qkv[qrow][c0 + 56];
          let q57 = qkv[qrow][c0 + 57];
          let q58 = qkv[qrow][c0 + 58];
          let q59 = qkv[qrow][c0 + 59];
          let q60 = qkv[qrow][c0 + 60];
          let q61 = qkv[qrow][c0 + 61];
          let q62 = qkv[qrow][c0 + 62];
          let q63 = qkv[qrow][c0 + 63];
          for t2 in 0..(t + 1) {
            let kr = row0 + t2;
            let mut val : f32 = 0.0;
            val = val + q0 * qkv[kr][C + c0];
            val = val + q1 * qkv[kr][C + c0 + 1];
            val = val + q2 * qkv[kr][C + c0 + 2];
            val = val + q3 * qkv[kr][C + c0 + 3];
            val = val + q4 * qkv[kr][C + c0 + 4];
            val = val + q5 * qkv[kr][C + c0 + 5];
            val = val + q6 * qkv[kr][C + c0 + 6];
            val = val + q7 * qkv[kr][C + c0 + 7];
            val = val + q8 * qkv[kr][C + c0 + 8];
            val = val + q9 * qkv[kr][C + c0 + 9];
            val = val + q10 * qkv[kr][C + c0 + 10];
            val = val + q11 * qkv[kr][C + c0 + 11];
            val = val + q12 * qkv[kr][C + c0 + 12];
            val = val + q13 * qkv[kr][C + c0 + 13];
            val = val + q14 * qkv[kr][C + c0 + 14];
            val = val + q15 * qkv[kr][C + c0 + 15];
            val = val + q16 * qkv[kr][C + c0 + 16];
            val = val + q17 * qkv[kr][C + c0 + 17];
            val = val + q18 * qkv[kr][C + c0 + 18];
            val = val + q19 * qkv[kr][C + c0 + 19];
            val = val + q20 * qkv[kr][C + c0 + 20];
            val = val + q21 * qkv[kr][C + c0 + 21];
            val = val + q22 * qkv[kr][C + c0 + 22];
            val = val + q23 * qkv[kr][C + c0 + 23];
            val = val + q24 * qkv[kr][C + c0 + 24];
            val = val + q25 * qkv[kr][C + c0 + 25];
            val = val + q26 * qkv[kr][C + c0 + 26];
            val = val + q27 * qkv[kr][C + c0 + 27];
            val = val + q28 * qkv[kr][C + c0 + 28];
            val = val + q29 * qkv[kr][C + c0 + 29];
            val = val + q30 * qkv[kr][C + c0 + 30];
            val = val + q31 * qkv[kr][C + c0 + 31];
            val = val + q32 * qkv[kr][C + c0 + 32];
            val = val + q33 * qkv[kr][C + c0 + 33];
            val = val + q34 * qkv[kr][C + c0 + 34];
            val = val + q35 * qkv[kr][C + c0 + 35];
            val = val + q36 * qkv[kr][C + c0 + 36];
            val = val + q37 * qkv[kr][C + c0 + 37];
            val = val + q38 * qkv[kr][C + c0 + 38];
            val = val + q39 * qkv[kr][C + c0 + 39];
            val = val + q40 * qkv[kr][C + c0 + 40];
            val = val + q41 * qkv[kr][C + c0 + 41];
            val = val + q42 * qkv[kr][C + c0 + 42];
            val = val + q43 * qkv[kr][C + c0 + 43];
            val = val + q44 * qkv[kr][C + c0 + 44];
            val = val + q45 * qkv[kr][C + c0 + 45];
            val = val + q46 * qkv[kr][C + c0 + 46];
            val = val + q47 * qkv[kr][C + c0 + 47];
            val = val + q48 * qkv[kr][C + c0 + 48];
            val = val + q49 * qkv[kr][C + c0 + 49];
            val = val + q50 * qkv[kr][C + c0 + 50];
            val = val + q51 * qkv[kr][C + c0 + 51];
            val = val + q52 * qkv[kr][C + c0 + 52];
            val = val + q53 * qkv[kr][C + c0 + 53];
            val = val + q54 * qkv[kr][C + c0 + 54];
            val = val + q55 * qkv[kr][C + c0 + 55];
            val = val + q56 * qkv[kr][C + c0 + 56];
            val = val + q57 * qkv[kr][C + c0 + 57];
            val = val + q58 * qkv[kr][C + c0 + 58];
            val = val + q59 * qkv[kr][C + c0 + 59];
            val = val + q60 * qkv[kr][C + c0 + 60];
            val = val + q61 * qkv[kr][C + c0 + 61];
            val = val + q62 * qkv[kr][C + c0 + 62];
            val = val + q63 * qkv[kr][C + c0 + 63];
            val = val * scale;
            if val > maxval { maxval = val; }
            preatt[r][t2] = val;
          }
        } else {
          for chunk in 0..(hs / 16) {
            let c = c0 + chunk * 16;
            let q0 = qkv[qrow][c];
            let q1 = qkv[qrow][c + 1];
            let q2 = qkv[qrow][c + 2];
            let q3 = qkv[qrow][c + 3];
            let q4 = qkv[qrow][c + 4];
            let q5 = qkv[qrow][c + 5];
            let q6 = qkv[qrow][c + 6];
            let q7 = qkv[qrow][c + 7];
            let q8 = qkv[qrow][c + 8];
            let q9 = qkv[qrow][c + 9];
            let q10 = qkv[qrow][c + 10];
            let q11 = qkv[qrow][c + 11];
            let q12 = qkv[qrow][c + 12];
            let q13 = qkv[qrow][c + 13];
            let q14 = qkv[qrow][c + 14];
            let q15 = qkv[qrow][c + 15];
            for t2 in 0..(t + 1) {
              let kr = row0 + t2;
              let mut val : f32 = 0.0;
              if chunk > 0 { val = preatt[r][t2]; }
              val = val + q0 * qkv[kr][C + c];
              val = val + q1 * qkv[kr][C + c + 1];
              val = val + q2 * qkv[kr][C + c + 2];
              val = val + q3 * qkv[kr][C + c + 3];
              val = val + q4 * qkv[kr][C + c + 4];
              val = val + q5 * qkv[kr][C + c + 5];
              val = val + q6 * qkv[kr][C + c + 6];
              val = val + q7 * qkv[kr][C + c + 7];
              val = val + q8 * qkv[kr][C + c + 8];
              val = val + q9 * qkv[kr][C + c + 9];
              val = val + q10 * qkv[kr][C + c + 10];
              val = val + q11 * qkv[kr][C + c + 11];
              val = val + q12 * qkv[kr][C + c + 12];
              val = val + q13 * qkv[kr][C + c + 13];
              val = val + q14 * qkv[kr][C + c + 14];
              val = val + q15 * qkv[kr][C + c + 15];
              preatt[r][t2] = val;
            }
          }
          for t2 in 0..(t + 1) {
            let val = preatt[r][t2] * scale;
            if val > maxval { maxval = val; }
            preatt[r][t2] = val;
          }
        }
        let mut expsum : f32 = 0.0;
        for t2 in 0..(t + 1) {
          let expv = (preatt[r][t2] - maxval).exp();
          expsum = expsum + expv;
          att[r][t2] = expv;
        }
        let mut expsum_inv : f32 = 0.0;
        if expsum != 0.0 { expsum_inv = 1.0 / expsum; }
        for t2 in 0..(t + 1) {
          att[r][t2] = att[r][t2] * expsum_inv;
        }
      }
    }
  }
  return;
}

// The attention output of one (batch, head, position): out[i] = the sum over
// t2 <= t of att[t2] * value[t2][i], into the first hs columns of that row of
// `scratch`. The caller passes preatt, which nothing reads once att is computed.
// One thread per row of att, K outputs per pass over the row.
fn k_attention_out_head<const RA : i32, const T : i32, const R : i32, const C3 : i32>(
    scratch : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, att : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
