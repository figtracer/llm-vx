            let mut s13 : f32 = 0.0;
            let mut s14 : f32 = 0.0;
            let mut s15 : f32 = 0.0;
            for t2 in 0..(t + 1) {
              let w = att[r][t2];
              let v = row0 + t2;
              s0 = s0 + w * qkv[v][c];
              s1 = s1 + w * qkv[v][c + 1];
              s2 = s2 + w * qkv[v][c + 2];
              s3 = s3 + w * qkv[v][c + 3];
              s4 = s4 + w * qkv[v][c + 4];
              s5 = s5 + w * qkv[v][c + 5];
              s6 = s6 + w * qkv[v][c + 6];
              s7 = s7 + w * qkv[v][c + 7];
              s8 = s8 + w * qkv[v][c + 8];
              s9 = s9 + w * qkv[v][c + 9];
              s10 = s10 + w * qkv[v][c + 10];
              s11 = s11 + w * qkv[v][c + 11];
              s12 = s12 + w * qkv[v][c + 12];
              s13 = s13 + w * qkv[v][c + 13];
              s14 = s14 + w * qkv[v][c + 14];
              s15 = s15 + w * qkv[v][c + 15];
            }
            scratch[r][i0] = s0;
            scratch[r][i0 + 1] = s1;
            scratch[r][i0 + 2] = s2;
            scratch[r][i0 + 3] = s3;
            scratch[r][i0 + 4] = s4;
            scratch[r][i0 + 5] = s5;
            scratch[r][i0 + 6] = s6;
            scratch[r][i0 + 7] = s7;
            scratch[r][i0 + 8] = s8;
            scratch[r][i0 + 9] = s9;
            scratch[r][i0 + 10] = s10;
            scratch[r][i0 + 11] = s11;
            scratch[r][i0 + 12] = s12;
            scratch[r][i0 + 13] = s13;
            scratch[r][i0 + 14] = s14;
            scratch[r][i0 + 15] = s15;
          }
        }
      }
    }
  }
  return;
}

// For one query position: datt from the values, then dpreatt through the
// softmax in O(T), as llm.c's CUDA version computes it:
// dpreatt[t3] = att[t3] * (datt[t3] - sum over t2 of att[t2] * datt[t2]).
// llm.c's CPU code sums the O(T^2) form, which differs only in rounding and
// costs about T^3 / 3 multiply-adds per head. Both are assigned, not
// accumulated, so neither needs zeroing before a step; nothing reads them above
// the diagonal. dout's components stay in registers, as the query's do in the
// forward scores.
fn k_attention_backward_scores<const RA : i32, const T : i32, const R : i32, const C3 : i32, const C : i32>(
    dpreatt : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, datt : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>,
    att : &Tensor<f32, [RA, T], Memory::GPU_HBM>, qkv : &Tensor<f32, [R, C3], Memory::GPU_HBM>,
    dout : &Tensor<f32, [R, C], Memory::GPU_HBM>, NH : i32, BT : i32, l : i32, lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..RA {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / (NH * T);
        let h = (rr / T) % NH;
        let t = rr % T;
        let o = l * BT + b * T + t;
        let row0 = l * BT + b * T;
        let c0 = h * hs;
        let mut dot : f32 = 0.0;
        if hs == 64 {
          let d0 = dout[o][c0];
          let d1 = dout[o][c0 + 1];
          let d2 = dout[o][c0 + 2];
          let d3 = dout[o][c0 + 3];
          let d4 = dout[o][c0 + 4];
          let d5 = dout[o][c0 + 5];
          let d6 = dout[o][c0 + 6];
          let d7 = dout[o][c0 + 7];
          let d8 = dout[o][c0 + 8];
          let d9 = dout[o][c0 + 9];
          let d10 = dout[o][c0 + 10];
          let d11 = dout[o][c0 + 11];
          let d12 = dout[o][c0 + 12];
          let d13 = dout[o][c0 + 13];
          let d14 = dout[o][c0 + 14];
          let d15 = dout[o][c0 + 15];
          let d16 = dout[o][c0 + 16];
          let d17 = dout[o][c0 + 17];
          let d18 = dout[o][c0 + 18];
          let d19 = dout[o][c0 + 19];
          let d20 = dout[o][c0 + 20];
          let d21 = dout[o][c0 + 21];
          let d22 = dout[o][c0 + 22];
          let d23 = dout[o][c0 + 23];
          let d24 = dout[o][c0 + 24];
          let d25 = dout[o][c0 + 25];
          let d26 = dout[o][c0 + 26];
          let d27 = dout[o][c0 + 27];
          let d28 = dout[o][c0 + 28];
          let d29 = dout[o][c0 + 29];
          let d30 = dout[o][c0 + 30];
          let d31 = dout[o][c0 + 31];
          let d32 = dout[o][c0 + 32];
          let d33 = dout[o][c0 + 33];
          let d34 = dout[o][c0 + 34];
          let d35 = dout[o][c0 + 35];
          let d36 = dout[o][c0 + 36];
          let d37 = dout[o][c0 + 37];
          let d38 = dout[o][c0 + 38];
          let d39 = dout[o][c0 + 39];
          let d40 = dout[o][c0 + 40];
          let d41 = dout[o][c0 + 41];
          let d42 = dout[o][c0 + 42];
          let d43 = dout[o][c0 + 43];
          let d44 = dout[o][c0 + 44];
          let d45 = dout[o][c0 + 45];
          let d46 = dout[o][c0 + 46];
          let d47 = dout[o][c0 + 47];
          let d48 = dout[o][c0 + 48];
          let d49 = dout[o][c0 + 49];
          let d50 = dout[o][c0 + 50];
          let d51 = dout[o][c0 + 51];
          let d52 = dout[o][c0 + 52];
          let d53 = dout[o][c0 + 53];
          let d54 = dout[o][c0 + 54];
          let d55 = dout[o][c0 + 55];
          let d56 = dout[o][c0 + 56];
          let d57 = dout[o][c0 + 57];
          let d58 = dout[o][c0 + 58];
          let d59 = dout[o][c0 + 59];
          let d60 = dout[o][c0 + 60];
          let d61 = dout[o][c0 + 61];
          let d62 = dout[o][c0 + 62];
          let d63 = dout[o][c0 + 63];
          for t2 in 0..(t + 1) {
            let v = row0 + t2;
            let mut acc : f32 = 0.0;
            acc = acc + qkv[v][C * 2 + c0] * d0;
            acc = acc + qkv[v][C * 2 + c0 + 1] * d1;
            acc = acc + qkv[v][C * 2 + c0 + 2] * d2;
            acc = acc + qkv[v][C * 2 + c0 + 3] * d3;
            acc = acc + qkv[v][C * 2 + c0 + 4] * d4;
            acc = acc + qkv[v][C * 2 + c0 + 5] * d5;
            acc = acc + qkv[v][C * 2 + c0 + 6] * d6;
            acc = acc + qkv[v][C * 2 + c0 + 7] * d7;
            acc = acc + qkv[v][C * 2 + c0 + 8] * d8;
            acc = acc + qkv[v][C * 2 + c0 + 9] * d9;
            acc = acc + qkv[v][C * 2 + c0 + 10] * d10;
            acc = acc + qkv[v][C * 2 + c0 + 11] * d11;
            acc = acc + qkv[v][C * 2 + c0 + 12] * d12;
            acc = acc + qkv[v][C * 2 + c0 + 13] * d13;
            acc = acc + qkv[v][C * 2 + c0 + 14] * d14;
            acc = acc + qkv[v][C * 2 + c0 + 15] * d15;
            acc = acc + qkv[v][C * 2 + c0 + 16] * d16;
            acc = acc + qkv[v][C * 2 + c0 + 17] * d17;
            acc = acc + qkv[v][C * 2 + c0 + 18] * d18;
            acc = acc + qkv[v][C * 2 + c0 + 19] * d19;
            acc = acc + qkv[v][C * 2 + c0 + 20] * d20;
            acc = acc + qkv[v][C * 2 + c0 + 21] * d21;
            acc = acc + qkv[v][C * 2 + c0 + 22] * d22;
            acc = acc + qkv[v][C * 2 + c0 + 23] * d23;
            acc = acc + qkv[v][C * 2 + c0 + 24] * d24;
            acc = acc + qkv[v][C * 2 + c0 + 25] * d25;
            acc = acc + qkv[v][C * 2 + c0 + 26] * d26;
            acc = acc + qkv[v][C * 2 + c0 + 27] * d27;
            acc = acc + qkv[v][C * 2 + c0 + 28] * d28;
            acc = acc + qkv[v][C * 2 + c0 + 29] * d29;
            acc = acc + qkv[v][C * 2 + c0 + 30] * d30;
            acc = acc + qkv[v][C * 2 + c0 + 31] * d31;
            acc = acc + qkv[v][C * 2 + c0 + 32] * d32;
            acc = acc + qkv[v][C * 2 + c0 + 33] * d33;
            acc = acc + qkv[v][C * 2 + c0 + 34] * d34;
            acc = acc + qkv[v][C * 2 + c0 + 35] * d35;
            acc = acc + qkv[v][C * 2 + c0 + 36] * d36;
            acc = acc + qkv[v][C * 2 + c0 + 37] * d37;
            acc = acc + qkv[v][C * 2 + c0 + 38] * d38;
            acc = acc + qkv[v][C * 2 + c0 + 39] * d39;
            acc = acc + qkv[v][C * 2 + c0 + 40] * d40;
            acc = acc + qkv[v][C * 2 + c0 + 41] * d41;
            acc = acc + qkv[v][C * 2 + c0 + 42] * d42;
            acc = acc + qkv[v][C * 2 + c0 + 43] * d43;
            acc = acc + qkv[v][C * 2 + c0 + 44] * d44;
            acc = acc + qkv[v][C * 2 + c0 + 45] * d45;
            acc = acc + qkv[v][C * 2 + c0 + 46] * d46;
            acc = acc + qkv[v][C * 2 + c0 + 47] * d47;
            acc = acc + qkv[v][C * 2 + c0 + 48] * d48;
            acc = acc + qkv[v][C * 2 + c0 + 49] * d49;
            acc = acc + qkv[v][C * 2 + c0 + 50] * d50;
            acc = acc + qkv[v][C * 2 + c0 + 51] * d51;
            acc = acc + qkv[v][C * 2 + c0 + 52] * d52;
            acc = acc + qkv[v][C * 2 + c0 + 53] * d53;
            acc = acc + qkv[v][C * 2 + c0 + 54] * d54;
            acc = acc + qkv[v][C * 2 + c0 + 55] * d55;
            acc = acc + qkv[v][C * 2 + c0 + 56] * d56;
            acc = acc + qkv[v][C * 2 + c0 + 57] * d57;
            acc = acc + qkv[v][C * 2 + c0 + 58] * d58;
            acc = acc + qkv[v][C * 2 + c0 + 59] * d59;
            acc = acc + qkv[v][C * 2 + c0 + 60] * d60;
            acc = acc + qkv[v][C * 2 + c0 + 61] * d61;
            acc = acc + qkv[v][C * 2 + c0 + 62] * d62;
            acc = acc + qkv[v][C * 2 + c0 + 63] * d63;
            datt[r][t2] = acc;
            dot = dot + att[r][t2] * acc;
          }
        } else {
          for chunk in 0..(hs / 16) {
            let c = c0 + chunk * 16;
            let d0 = dout[o][c];
            let d1 = dout[o][c + 1];
            let d2 = dout[o][c + 2];
            let d3 = dout[o][c + 3];
            let d4 = dout[o][c + 4];
            let d5 = dout[o][c + 5];
            let d6 = dout[o][c + 6];
            let d7 = dout[o][c + 7];
            let d8 = dout[o][c + 8];
            let d9 = dout[o][c + 9];
            let d10 = dout[o][c + 10];
            let d11 = dout[o][c + 11];
            let d12 = dout[o][c + 12];
            let d13 = dout[o][c + 13];
            let d14 = dout[o][c + 14];
            let d15 = dout[o][c + 15];
            for t2 in 0..(t + 1) {
              let v = row0 + t2;
              let mut acc : f32 = 0.0;
              if chunk > 0 { acc = datt[r][t2]; }
              acc = acc + qkv[v][C * 2 + c] * d0;
              acc = acc + qkv[v][C * 2 + c + 1] * d1;
              acc = acc + qkv[v][C * 2 + c + 2] * d2;
              acc = acc + qkv[v][C * 2 + c + 3] * d3;
              acc = acc + qkv[v][C * 2 + c + 4] * d4;
              acc = acc + qkv[v][C * 2 + c + 5] * d5;
              acc = acc + qkv[v][C * 2 + c + 6] * d6;
              acc = acc + qkv[v][C * 2 + c + 7] * d7;
              acc = acc + qkv[v][C * 2 + c + 8] * d8;
              acc = acc + qkv[v][C * 2 + c + 9] * d9;
              acc = acc + qkv[v][C * 2 + c + 10] * d10;
              acc = acc + qkv[v][C * 2 + c + 11] * d11;
              acc = acc + qkv[v][C * 2 + c + 12] * d12;
              acc = acc + qkv[v][C * 2 + c + 13] * d13;
              acc = acc + qkv[v][C * 2 + c + 14] * d14;
              acc = acc + qkv[v][C * 2 + c + 15] * d15;
              datt[r][t2] = acc;
            }
          }
          for t2 in 0..(t + 1) { dot = dot + att[r][t2] * datt[r][t2]; }
        }
        for t3 in 0..(t + 1) {
          dpreatt[r][t3] = att[r][t3] * (datt[r][t3] - dot);
        }
      }
    }
  }
  return;
}

// One part of dqkv (0 dquery, 1 dkey, 2 dvalue) for one (batch, head, position),
// into the first hs columns of that row of `scratch`. The caller passes datt,
// which no later kernel reads. One thread per row of att: twelve times as many
// threads as one per position. dquery sums over the keys before the position,
// dkey and dvalue over the queries at or after it. The second loop runs over
// every query and skips the earlier ones, so a warp reads one row of att and
// dpreatt at a time. K outputs per pass.
fn k_attention_backward_part<const RA : i32, const T : i32, const R : i32, const C3 : i32, const C : i32>(
    scratch : &mut Tensor<f32, [RA, T], Memory::GPU_HBM>, dpreatt : &Tensor<f32, [RA, T], Memory::GPU_HBM>,
    att : &Tensor<f32, [RA, T], Memory::GPU_HBM>, qkv : &Tensor<f32, [R, C3], Memory::GPU_HBM>,
    dout : &Tensor<f32, [R, C], Memory::GPU_HBM>, NH : i32, BT : i32, l : i32, scale : f32, part : i32,
    lo : i32, n : i32) -> void {
  let hs = C / NH;
  spawn on(Topology::GPU) {
    for r in 0..RA {
      if r >= lo && r < lo + n {
        let rr = r - lo;
        let b = rr / (NH * T);
        let h = (rr / T) % NH;
        let t = rr % T;
        let arow = lo + b * NH * T + h * T;
        let row0 = l * BT + b * T;
        let c0 = h * hs;
        if hs == 64 {
          let i0 = 0;
          let mut s0 : f32 = 0.0;
          let mut s1 : f32 = 0.0;
          let mut s2 : f32 = 0.0;
          let mut s3 : f32 = 0.0;
          let mut s4 : f32 = 0.0;
          let mut s5 : f32 = 0.0;
          let mut s6 : f32 = 0.0;
          let mut s7 : f32 = 0.0;
          let mut s8 : f32 = 0.0;
          let mut s9 : f32 = 0.0;
          let mut s10 : f32 = 0.0;
          let mut s11 : f32 = 0.0;
          let mut s12 : f32 = 0.0;
          let mut s13 : f32 = 0.0;
          let mut s14 : f32 = 0.0;
          let mut s15 : f32 = 0.0;
          let mut s16 : f32 = 0.0;
          let mut s17 : f32 = 0.0;
          let mut s18 : f32 = 0.0;
          let mut s19 : f32 = 0.0;
          let mut s20 : f32 = 0.0;
          let mut s21 : f32 = 0.0;
          let mut s22 : f32 = 0.0;
          let mut s23 : f32 = 0.0;
          let mut s24 : f32 = 0.0;
          let mut s25 : f32 = 0.0;
          let mut s26 : f32 = 0.0;
          let mut s27 : f32 = 0.0;
          let mut s28 : f32 = 0.0;
          let mut s29 : f32 = 0.0;
          let mut s30 : f32 = 0.0;
          let mut s31 : f32 = 0.0;
          let mut s32 : f32 = 0.0;
          let mut s33 : f32 = 0.0;
          let mut s34 : f32 = 0.0;
          let mut s35 : f32 = 0.0;
          let mut s36 : f32 = 0.0;
          let mut s37 : f32 = 0.0;
          let mut s38 : f32 = 0.0;
          let mut s39 : f32 = 0.0;
          let mut s40 : f32 = 0.0;
          let mut s41 : f32 = 0.0;
          let mut s42 : f32 = 0.0;
          let mut s43 : f32 = 0.0;
          let mut s44 : f32 = 0.0;
          let mut s45 : f32 = 0.0;
          let mut s46 : f32 = 0.0;
          let mut s47 : f32 = 0.0;
          let mut s48 : f32 = 0.0;
          let mut s49 : f32 = 0.0;
          let mut s50 : f32 = 0.0;
          let mut s51 : f32 = 0.0;
          let mut s52 : f32 = 0.0;
          let mut s53 : f32 = 0.0;
          let mut s54 : f32 = 0.0;
          let mut s55 : f32 = 0.0;
          let mut s56 : f32 = 0.0;
          let mut s57 : f32 = 0.0;
          let mut s58 : f32 = 0.0;
          let mut s59 : f32 = 0.0;
          let mut s60 : f32 = 0.0;
          let mut s61 : f32 = 0.0;
          let mut s62 : f32 = 0.0;
          let mut s63 : f32 = 0.0;
          if part == 0 {
            let c = C + c0 + i0;
            for t2 in 0..(t + 1) {
              let d = dpreatt[r][t2];
              let kr = row0 + t2;
              s0 = s0 + qkv[kr][c] * d * scale;
              s1 = s1 + qkv[kr][c + 1] * d * scale;
              s2 = s2 + qkv[kr][c + 2] * d * scale;
              s3 = s3 + qkv[kr][c + 3] * d * scale;
              s4 = s4 + qkv[kr][c + 4] * d * scale;
              s5 = s5 + qkv[kr][c + 5] * d * scale;
              s6 = s6 + qkv[kr][c + 6] * d * scale;
              s7 = s7 + qkv[kr][c + 7] * d * scale;
              s8 = s8 + qkv[kr][c + 8] * d * scale;
              s9 = s9 + qkv[kr][c + 9] * d * scale;
              s10 = s10 + qkv[kr][c + 10] * d * scale;
              s11 = s11 + qkv[kr][c + 11] * d * scale;
              s12 = s12 + qkv[kr][c + 12] * d * scale;
              s13 = s13 + qkv[kr][c + 13] * d * scale;
              s14 = s14 + qkv[kr][c + 14] * d * scale;
              s15 = s15 + qkv[kr][c + 15] * d * scale;
              s16 = s16 + qkv[kr][c + 16] * d * scale;
              s17 = s17 + qkv[kr][c + 17] * d * scale;
              s18 = s18 + qkv[kr][c + 18] * d * scale;
              s19 = s19 + qkv[kr][c + 19] * d * scale;
              s20 = s20 + qkv[kr][c + 20] * d * scale;
              s21 = s21 + qkv[kr][c + 21] * d * scale;
              s22 = s22 + qkv[kr][c + 22] * d * scale;
              s23 = s23 + qkv[kr][c + 23] * d * scale;
              s24 = s24 + qkv[kr][c + 24] * d * scale;
              s25 = s25 + qkv[kr][c + 25] * d * scale;
              s26 = s26 + qkv[kr][c + 26] * d * scale;
              s27 = s27 + qkv[kr][c + 27] * d * scale;
              s28 = s28 + qkv[kr][c + 28] * d * scale;
              s29 = s29 + qkv[kr][c + 29] * d * scale;
              s30 = s30 + qkv[kr][c + 30] * d * scale;
              s31 = s31 + qkv[kr][c + 31] * d * scale;
              s32 = s32 + qkv[kr][c + 32] * d * scale;
              s33 = s33 + qkv[kr][c + 33] * d * scale;
              s34 = s34 + qkv[kr][c + 34] * d * scale;
              s35 = s35 + qkv[kr][c + 35] * d * scale;
              s36 = s36 + qkv[kr][c + 36] * d * scale;
              s37 = s37 + qkv[kr][c + 37] * d * scale;
              s38 = s38 + qkv[kr][c + 38] * d * scale;
              s39 = s39 + qkv[kr][c + 39] * d * scale;
              s40 = s40 + qkv[kr][c + 40] * d * scale;
              s41 = s41 + qkv[kr][c + 41] * d * scale;
              s42 = s42 + qkv[kr][c + 42] * d * scale;
              s43 = s43 + qkv[kr][c + 43] * d * scale;
              s44 = s44 + qkv[kr][c + 44] * d * scale;
              s45 = s45 + qkv[kr][c + 45] * d * scale;
              s46 = s46 + qkv[kr][c + 46] * d * scale;
              s47 = s47 + qkv[kr][c + 47] * d * scale;
              s48 = s48 + qkv[kr][c + 48] * d * scale;
              s49 = s49 + qkv[kr][c + 49] * d * scale;
              s50 = s50 + qkv[kr][c + 50] * d * scale;
              s51 = s51 + qkv[kr][c + 51] * d * scale;
              s52 = s52 + qkv[kr][c + 52] * d * scale;
              s53 = s53 + qkv[kr][c + 53] * d * scale;
              s54 = s54 + qkv[kr][c + 54] * d * scale;
              s55 = s55 + qkv[kr][c + 55] * d * scale;
              s56 = s56 + qkv[kr][c + 56] * d * scale;
              s57 = s57 + qkv[kr][c + 57] * d * scale;
              s58 = s58 + qkv[kr][c + 58] * d * scale;
              s59 = s59 + qkv[kr][c + 59] * d * scale;
              s60 = s60 + qkv[kr][c + 60] * d * scale;
              s61 = s61 + qkv[kr][c + 61] * d * scale;
              s62 = s62 + qkv[kr][c + 62] * d * scale;
              s63 = s63 + qkv[kr][c + 63] * d * scale;
            }
          } else if part == 1 {
            let c = c0 + i0;
            for tq in 0..T {
              if tq >= t {
                let d = dpreatt[arow + tq][t];
                let q = row0 + tq;
                s0 = s0 + qkv[q][c] * d * scale;
                s1 = s1 + qkv[q][c + 1] * d * scale;
                s2 = s2 + qkv[q][c + 2] * d * scale;
                s3 = s3 + qkv[q][c + 3] * d * scale;
                s4 = s4 + qkv[q][c + 4] * d * scale;
                s5 = s5 + qkv[q][c + 5] * d * scale;
                s6 = s6 + qkv[q][c + 6] * d * scale;
                s7 = s7 + qkv[q][c + 7] * d * scale;
                s8 = s8 + qkv[q][c + 8] * d * scale;
                s9 = s9 + qkv[q][c + 9] * d * scale;
                s10 = s10 + qkv[q][c + 10] * d * scale;
