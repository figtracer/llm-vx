// A GPU for running the GPU program anywhere. On a host without Vx's CUDA
// plugin (any Mac), `spawn` blocks run on the CPU and transfers are copies.
//
// GPU_HBM is `within: Memory::CPU_DRAM` so a kernel can take host scalars and
// tensor references (Vx#850), and `managed: cached` because Vx refuses
// non-matmul kernels on operands in an explicitly managed space.
Memory CPU_DRAM {}
Memory GPU_HBM {
  within: Memory::CPU_DRAM, capacity: 64 GiB, bandwidth: 100 GB/s, managed: cached, scope: device
}
